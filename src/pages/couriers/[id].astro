---
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import { PUBLISHED_CARRIERS, LEVELS, METRICS, CATALOGS, type Carrier } from '../../data/api.ts'
import { FREE } from '../../data/plans.ts'

/* Una página por courier.
 *
 * ── Por qué no alcanza con la portada ──
 *
 * Quien busca «api rastreo olva» no busca lo mismo que quien busca «api tracking
 * shalom», y una sola página no puede rankear para las dos: un buscador ordena
 * PÁGINAS por tema, y una que habla de cinco couriers a la vez no es la mejor
 * respuesta para ninguno. Cinco páginas, cada una con su tema, sí.
 *
 * ── El riesgo, y cómo se evita ──
 *
 * Generar cinco plantillas con el nombre cambiado es exactamente lo que los
 * buscadores penalizan, y con razón: no aportan nada. Por eso cada página se
 * arma con lo que este courier tiene de PROPIO —qué funciona y qué no, con el
 * motivo concreto, su nivel de evidencia, si su número de guía se reconoce solo,
 * si se puede suscribir— y el texto compartido se mantiene al mínimo.
 *
 * Si algún día dos couriers quedan con el mismo contenido, la página deja de
 * merecer existir. Hoy no pasa: las notas de cada uno son distintas porque el
 * estado de cada integración es distinto.
 */

export function getStaticPaths() {
  return PUBLISHED_CARRIERS.map((c) => ({ params: { id: c.id }, props: { carrier: c } }))
}

interface Props {
  carrier: Carrier
}

const { carrier: c } = Astro.props

const tracks = c.tracking.status === 'ok'
const hasCatalog = c.agencies.status === 'ok'

const detectionNote: Record<string, string> = {
  strong: 'Su formato de guía es inconfundible, así que podemos detectarlo solos: puedes omitir el parámetro carrier.',
  weak: 'Su formato se parece al de otros couriers. Conviene mandar el carrier explícito para evitar una detección equivocada.',
  none: 'No hay forma de reconocerlo por el número de guía. El parámetro carrier es obligatorio.',
}

/* CREAR guías.
 *
 * Este bloque existía en el dato (`shipping`) y sólo lo pintaba la portada, así
 * que la página del courier —la que debería ser la mejor respuesta para «api
 * olva»— era la que MENOS sabía de Olva. Peor: era lo único que distinguía a
 * estas cinco páginas entre sí, porque rastreo y agencias las describen casi
 * igual. Crear es el eje donde de verdad se diferencian: hoy dos de cinco lo
 * soportan, y con credenciales distintas.
 */
const creates = c.shipping.status === 'ok'

/* Con qué credencial se crea. No es un detalle de implementación: `platform`
   significa que alcanza con tu API key, y `customer_account` obliga a pedirle al
   usuario final su cuenta del courier — eso cambia el alta del producto entero,
   no sólo la llamada. */
const authNote: Record<'platform' | 'customer_account', string> = {
  platform: `Se crea con tu API key y nada más: ${c.name} no le pide credenciales a tu usuario final.`,
  customer_account: `Requiere la cuenta del cliente en ${c.name}. El usuario final tiene que conectarla antes de poder generar una guía, y ese paso hay que preverlo en tu alta.`,
}

const deliveryLabel: Record<'agency' | 'home', string> = {
  agency: 'recojo en agencia',
  home: 'entrega a domicilio',
}

/* ── Lo que hace que esta página no sea las otras cuatro ──
 *
 * Con `tracking.note` y `agencies.note` sólo había entre 34 y 87 palabras propias
 * por página: el resto era plantilla, y cinco URLs así se consolidan en una.
 *
 * Lo que falta no es redacción, es DATO. Y el dato existe: el catálogo de cada
 * courier publica cosas distintas, y `CATALOGS` lo mide contra /v1/agencies en
 * cada build. Uno trae ubigeo INEI en todos sus puntos y los otros cuatro en
 * ninguno; uno no publica ni el departamento; dos parsean el horario y tres lo
 * dejan en texto.
 *
 * Por eso los dos bloques de abajo se CALCULAN en vez de escribirse. Tres razones,
 * y las tres importan igual:
 *   - no pueden envejecer, porque salen de la misma medición que el resto;
 *   - no pueden afirmar algo que el API desmienta, que es la regla de api.ts;
 *   - no pueden terminar iguales entre couriers, que es de lo que veníamos.
 *
 * Cada frase nombra a su courier a propósito: un extractor de pasajes —o un
 * modelo citando— se lleva la frase suelta, sin el título de la página.
 */
const cat = CATALOGS[c.id] ?? null
const otrosCat = PUBLISHED_CARRIERS.filter((o) => o.id !== c.id)
  .map((o) => CATALOGS[o.id])
  .filter(Boolean)

const pct = (x: number) => `${Math.round(x * 100)} %`
const tipo = (n: string) => cat?.kinds.find((k) => k.name === n)?.count ?? 0

/* Comparativos: hechos, no adjetivos. Si mañana otro courier publica ubigeo, la
   frase «es el único» desaparece sola. */
const masGrande = !!cat && otrosCat.every((o) => cat.total > o.total)
const unicoUbigeo = !!cat && cat.ubigeoRate >= 0.99 && otrosCat.every((o) => o.ubigeoRate < 0.5)
const paisCompleto = !!cat && cat.departments >= 25
const tresServicios =
  !!cat && ['dropoff', 'pickup', 'home_delivery'].every((s) => cat.services.includes(s))
const unicoAereo =
  !!cat && cat.services.includes('air') && otrosCat.every((o) => !o.services.includes('air'))
const distingueTipos = !!cat && cat.kinds.length > 1

const fuertes: string[] = []
if (cat) {
  if (unicoUbigeo)
    fuertes.push(
      `${c.name} es el único de los cinco que trae ubigeo INEI de distrito en todos sus puntos. Si vas a cruzar direcciones contra tablas oficiales, o a calcular cobertura por distrito, es el único que te lo da resuelto.`,
    )
  if (masGrande)
    fuertes.push(
      `Es el catálogo más grande de los cinco: ${c.name} publica ${cat.total} puntos, ${cat.total - Math.max(...otrosCat.map((o) => o.total))} más que el siguiente.`,
    )
  if (paisCompleto)
    fuertes.push(
      `${c.name} nombra puntos en los 25 departamentos del país, Callao incluido${cat.provinces ? `, y baja hasta ${cat.provinces} provincias` : ''}.`,
    )
  /* Provincias por punto: mide si la red es capilar o de capitales. Con la misma
     cantidad de departamentos, 154 provincias y 53 son dos productos distintos. */
  if (cat.provinces >= 90 && otrosCat.every((o) => cat.provinces > o.provinces))
    fuertes.push(
      `Es la red más capilar de las cinco: los puntos de ${c.name} se reparten en ${cat.provinces} provincias, no se concentran en las capitales.`,
    )
  if (tresServicios)
    fuertes.push(
      `${c.name} es el único que marca los tres servicios por punto —dropoff, pickup y entrega a domicilio—, así que es con el que mejor se arma un selector de punto de recojo.`,
    )
  if (unicoAereo)
    fuertes.push(
      `${c.name} es el único que marca qué puntos aceptan envío aéreo, que en Perú es la diferencia entre horas y días hacia selva y sierra.`,
    )
  if (cat.hoursRate >= 0.999)
    fuertes.push(
      `El horario de los ${cat.total} puntos de ${c.name} viene en franjas parseadas, no en texto libre: decidir si una agencia está abierta no te obliga a escribir un parser.`,
    )
  else if (cat.hoursRate >= 0.9)
    fuertes.push(
      `El ${pct(cat.hoursRate)} de los puntos de ${c.name} trae el horario en franjas parseadas, no en texto libre.`,
    )
  if (cat.geoRate >= 0.999)
    fuertes.push(
      `Los ${cat.total} puntos de ${c.name} traen coordenadas, así que resolver «el más cercano» no te obliga a geocodificar nada.`,
    )
  if (distingueTipos)
    fuertes.push(
      `${c.name} distingue el tipo de punto: ${tipo('agent') || tipo('hub')} de sus ${cat.total} son ${tipo('agent') ? 'agentes de terceros' : 'hubs'} y ${tipo('office')} son oficinas propias. No es lo mismo lo que puedes esperar de unos y de otros.`,
    )
}
if (c.detection === 'strong')
  fuertes.push(
    `El número de guía de ${c.name} es inconfundible, así que puedes consultarlo sin mandar el parámetro carrier.`,
  )
if (c.level === 'live')
  fuertes.push(
    `El rastreo de ${c.name} está verificado en vivo: el mapeo sale de respuestas reales capturadas contra su servicio, con acierto y con fallo.`,
  )
/* Los webhooks NO entran acá aunque estén: los cinco couriers son suscribibles,
   así que no son una razón para elegir éste. Un «fuerte» que comparten todos es
   relleno con forma de argumento, y encima repetiría texto entre las cinco
   páginas, que es de lo que veníamos. Viven en su propia tarjeta, más arriba. */

const limites: string[] = []
if (cat) {
  if (cat.departments === 0)
    limites.push(
      `${c.name} no publica departamento, provincia ni distrito: sus ${cat.total} puntos llegan con la dirección en una sola cadena sin estructurar. Si tu producto filtra puntos por ubicación, este catálogo no sirve tal cual.`,
    )
  else if (cat.departments < 25)
    limites.push(
      `${c.name} llega a ${cat.departments} de los 25 departamentos: no es cobertura nacional completa.`,
    )
  if (cat.provinces > 0 && cat.provinces < 60)
    limites.push(
      `La red de ${c.name} es de capitales, no capilar: sus ${cat.total} puntos cubren ${cat.provinces} provincias, menos de la mitad de las ${otrosCat.reduce((m, o) => Math.max(m, o.provinces), 0)} del catálogo más extendido.`,
    )
  if (cat.ubigeoRate < 0.5 && cat.departments > 0)
    limites.push(
      `El catálogo de ${c.name} no trae ubigeo INEI: nombra sus ${cat.departments} departamentos y ${cat.provinces} provincias en texto, pero cruzarlos contra tablas oficiales queda de tu lado.`,
    )
  if (cat.geoRate < 0.9)
    limites.push(
      `Sólo el ${pct(cat.geoRate)} de los puntos de ${c.name} trae coordenadas, así que una búsqueda por cercanía deja fuera al resto.`,
    )
  if (cat.hoursRate < 0.5)
    limites.push(
      `El horario de ${c.name} viene en texto libre${cat.hoursSample ? ` —así lo publica: «${cat.hoursSample}»—` : ''}, no en franjas parseadas: interpretarlo queda de tu lado.`,
    )
  if (!cat.services.length)
    limites.push(
      `${c.name} no publica qué hace cada punto, así que no puedes filtrar por recojo ni por entrega a domicilio.`,
    )
  if (!distingueTipos)
    limites.push(
      `${c.name} no distingue el tipo de punto: oficina propia, agente o hub llegan todos como unknown.`,
    )
}
if (c.level === 'contract_only')
  limites.push(
    `El rastreo de ${c.name} está verificado sólo contra el contrato: nunca obtuvimos de él una respuesta con datos reales. Es el único de los cinco en esa situación, y lo decimos acá antes de que lo descubras integrando.`,
  )
if (c.detection === 'none')
  limites.push(
    `No hay forma de reconocer un número de guía de ${c.name} por su formato: el parámetro carrier es obligatorio.`,
  )
else if (c.detection === 'weak')
  limites.push(
    `El formato de guía de ${c.name} se parece al de otros couriers. Conviene mandar el carrier explícito para no arriesgar una detección equivocada.`,
  )
if (c.requiresCode)
  limites.push(
    `Rastrear un envío de ${c.name} exige el código de orden además del número de guía, y ese código lo tiene el comprador, no tu sistema: hay que preverlo en tu propia interfaz.`,
  )
if (!creates) limites.push(`Todavía no se pueden crear guías de ${c.name}. ${c.shipping.note}`)
else if (c.shipping.delivery.length === 1 && c.shipping.delivery[0] === 'agency')
  limites.push(
    `Las guías de ${c.name} que crea el API son sólo de agencia a agencia: no cubren entrega a domicilio.`,
  )

/* El ejemplo usa el id real del carrier y un marcador para el número, porque el
   formato de guía de cada courier lo publica `GET /v1/carriers` y no lo tenemos
   acá. Inventarlo sería peor que omitirlo: alguien lo copia, le rebota y culpa
   al API. */
// Los carriers con `requiresCode` (Shalom hoy) exigen un 2º factor: el ejemplo
// suma `&code=` o copiar-y-pegar responde 422. Se arma por dato, no a mano, así
// que sale solo para el carrier que lo necesita y no envejece.
// Sin el `$` de prompt: quien copia la línea no se lo lleva adentro (y con
// resaltado, un prompt pasa por nombre del comando).
const curl = c.requiresCode
  ? `curl -H "X-API-Key: $API_KEY" \\
    "https://api.tracking-peru.com/v1/tracking?carrier=${c.id}&number=TU-NUMERO-DE-GUIA&code=TU-CODIGO-DE-ORDEN"`
  : `curl -H "X-API-Key: $API_KEY" \\
    "https://api.tracking-peru.com/v1/tracking?carrier=${c.id}&number=TU-NUMERO-DE-GUIA"`

/*
 * Título y descripción, ajustados al largo.
 *
 * La plantilla sola no alcanza: «Shalom» deja un título de 44 caracteres —Google
 * desperdicia media línea— y «Cruz del Sur Cargo» empuja la descripción a 162,
 * donde la corta. El nombre del courier no debería decidir si el metadato entra
 * en rango, así que se arma por partes y se recorta o se completa según mida.
 */
const base = `API de rastreo de ${c.name}`
const title =
  base.length + 21 < 50
    ? `${base} en Perú — API Tracking Perú` // los nombres cortos desaprovechan el ancho
    : `${base} — API Tracking Perú`

const cabeza = tracks
  ? `Rastrea envíos de ${c.name} desde un API REST, con estado canónico y webhooks firmados.`
  : `Estado real de la integración con ${c.name}: qué funciona hoy, qué falta y por qué.`

/* La cola llevaba el dato diferenciador de este courier, no una frase de relleno.
 *
 * Cuatro de las cinco descripciones eran carácter por carácter la misma con el
 * nombre cambiado («Estado real de la integración, nivel de evidencia y cómo
 * empezar»), que es exactamente la señal que hace que un buscador trate a cinco
 * URLs como la misma. Ahora sale de lo medido, igual que el cuerpo de la página.
 *
 * Se prueban de la más específica a la más genérica y se usa la primera que entre
 * en el corte: con una sola, un nombre largo la descartaba entera y la
 * descripción quedaba en 96 caracteres, desaprovechando más de lo que sobraba.
 */
const colas = [
  cat && cat.ubigeoRate >= 0.99 && `Ubigeo INEI en sus ${cat.total} agencias.`,
  cat && cat.departments === 0 && `${cat.total} agencias, sin departamento estructurado.`,
  cat && cat.provinces >= 90 && `${cat.total} agencias en ${cat.provinces} provincias.`,
  cat && cat.hoursRate >= 0.999 && `${cat.total} agencias con horario parseado.`,
  cat && cat.departments > 0 && `${cat.total} agencias en ${cat.departments} departamentos.`,
  cat && `${cat.total} agencias sincronizadas.`,
  'Nivel de evidencia y cómo empezar.',
].filter((x): x is string => typeof x === 'string')

/* 155, no 160: es donde Google corta en la práctica, y una descripción cortada
   pierde justo el final, que es donde va el dato que la hace distinta. */
const cola = colas.find((x) => cabeza.length + 1 + x.length <= 155) ?? ''
const description = cola ? `${cabeza} ${cola}` : cabeza


/* ── Preguntas frecuentes ──
 *
 * Ninguna página del sitio tenía contenido en formato pregunta-respuesta, que es
 * la forma que mejor se extrae: un modelo que cita, o un buscador que arma un
 * fragmento, se lleva un par pregunta/respuesta entero sin necesitar el contexto
 * de la página.
 *
 * REGLA: sólo entra la pregunta cuya RESPUESTA sea propia de este courier. Una
 * respuesta igual en las cinco páginas reintroduce el duplicado que costó
 * arreglar, y encima con el formato que más se copia. Por eso no hay preguntas
 * genéricas del tipo «¿qué es un estado canónico?» — ésas viven en /docs, que es
 * su lugar.
 *
 * El texto visible y el JSON-LD salen de esta misma lista: marcar como FAQPage
 * algo que no está a la vista es exactamente lo que las guías de datos
 * estructurados prohíben.
 */
const faqs: { q: string; a: string }[] = []

faqs.push({
  q: `¿Hay que mandar el parámetro carrier para rastrear un envío de ${c.name}?`,
  a:
    c.detection === 'strong'
      ? `No hace falta. El formato de guía de ${c.name} es inconfundible, así que el API lo reconoce solo: puedes llamar a GET /v1/tracking con el número y nada más. Mandarlo igual no molesta.`
      : c.detection === 'weak'
        ? `Conviene mandarlo. El formato de guía de ${c.name} se parece al de otros couriers peruanos, así que una detección equivocada es posible: con carrier=${c.id} explícito no hay ambigüedad.`
        : `Sí, es obligatorio. No hay forma de reconocer un número de guía de ${c.name} por su formato, así que sin carrier=${c.id} el API no sabe a quién preguntarle.`,
})

faqs.push({
  q: `¿Se pueden crear guías de ${c.name} desde el API?`,
  a: creates
    ? c.shipping.auth === 'platform'
      ? `Sí, con POST /v1/shipments y tu propia API key: ${c.name} no le pide credenciales a tu usuario final. ${c.shipping.note}`
      : `Sí, pero con la cuenta del cliente en ${c.name}, no con tu API key: el usuario final tiene que conectarla antes. ${c.shipping.note}`
    : `Todavía no. ${c.shipping.note} El rastreo de ${c.name} sí funciona: son dos integraciones separadas, contra backends distintos del courier.`,
})

if (c.requiresCode)
  faqs.push({
    q: `¿Qué se necesita además del número de guía para rastrear en ${c.name}?`,
    a: `El código de orden que figura en el comprobante del envío. ${c.name} es el único de los cinco que exige ese segundo factor, y sin él el rastreo responde 422. Ese código lo tiene el comprador y no tu sistema, así que hay que preverlo en tu propia interfaz.`,
  })

if (cat)
  faqs.push({
    q: `¿El catálogo de agencias de ${c.name} sirve para filtrar por ubicación?`,
    a:
      cat.ubigeoRate >= 0.99
        ? `Sí, y es el único de los cinco que lo resuelve del todo: los ${cat.total} puntos de ${c.name} traen ubigeo INEI a nivel distrito, así que puedes cruzarlos contra tablas oficiales sin normalizar nada.`
        : cat.departments === 0
          ? `No directamente. ${c.name} no publica departamento, provincia ni distrito: sus ${cat.total} puntos llegan con la dirección en una sola cadena sin estructurar, y sólo el ${pct(cat.geoRate)} trae coordenadas.`
          : `Parcialmente. ${c.name} nombra ${cat.departments} departamentos y ${cat.provinces} provincias en texto, pero sin ubigeo INEI: cruzarlo contra tablas oficiales queda de tu lado. El ${pct(cat.geoRate)} de sus puntos sí trae coordenadas.`,
  })

if (cat)
  faqs.push({
    q: `¿Se puede saber si una agencia de ${c.name} está abierta?`,
    a:
      cat.hoursRate >= 0.999
        ? `Sí. El horario de los ${cat.total} puntos de ${c.name} viene en franjas parseadas con día y hora, así que resolverlo es una comparación y no un parser.`
        : cat.hoursRate >= 0.5
          ? `En el ${pct(cat.hoursRate)} de sus puntos sí: ahí el horario viene en franjas parseadas. En el resto llega como texto y hay que interpretarlo.`
          : `No directamente. El horario de ${c.name} llega en texto libre${cat.hoursSample ? ` —así lo publica: «${cat.hoursSample}»—` : ''}, así que interpretarlo queda de tu lado.`,
  })


/* Datos estructurados.
 *
 * Era un `WebPage` suelto con un `Service` colgando de `about`. `WebPage` es el
 * tipo por DEFECTO: decir que una página es una página no aporta nada, y dejaba
 * la página del courier como el nodo más pobre del sitio siendo la que más datos
 * verificados tiene.
 *
 * Ahora es un @graph, como el de la portada, con cuatro cosas que antes no
 * estaban:
 *
 *   - El nodo de página se tipa también como FAQPage, porque ahora hay preguntas
 *     y respuestas de verdad a la vista. `mainEntity` son las Question: es lo que
 *     FAQPage exige, y por eso el Service se enlaza con `about`.
 *   - `BreadcrumbList`. La ruta / > couriers > {courier} ya existía en la URL y en
 *     el breadcrumb visible, pero no estaba declarada en ningún lado.
 *   - El `Service` pasa a ser un nodo con `@id` propio y `provider` apuntando al
 *     `@id` de la Organization de la portada, en vez de repetir una Organization
 *     anónima por página. Seis páginas describiendo «una organización llamada API
 *     Tracking Perú» son seis entidades sueltas; seis apuntando al mismo `@id`
 *     son una sola entidad con seis menciones, que es lo que se puede corroborar.
 *   - `isPartOf` referencia el `@id` del WebSite por el mismo motivo.
 *
 * Todo sale de la misma fuente que el texto visible: el schema no puede decir algo
 * que la página desmienta.
 */
const url = `https://tracking-peru.com/couriers/${c.id}`
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['WebPage', 'FAQPage'],
      '@id': `${url}#page`,
      url,
      name: title,
      description,
      inLanguage: 'es-PE',
      // Cuándo se sincronizó SU catálogo. Es la única fecha que esta página puede
      // afirmar de verdad —sale de `meta.sources[].synced_at`— y sin ella no había
      // ninguna señal de frescura: ni acá, ni en el sitemap, ni a la vista.
      ...(cat?.syncedAt ? { dateModified: cat.syncedAt } : {}),
      isPartOf: { '@id': 'https://tracking-peru.com/#website' },
      breadcrumb: { '@id': `${url}#breadcrumb` },
      about: { '@id': `${url}#service` },
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://tracking-peru.com/' },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Couriers',
          item: 'https://tracking-peru.com/couriers',
        },
        { '@type': 'ListItem', position: 3, name: c.name },
      ],
    },
    {
      '@type': 'Service',
      '@id': `${url}#service`,
      name: `API de rastreo de ${c.name}`,
      serviceType: 'API REST de rastreo de envíos',
      description: `Rastreo de envíos de ${c.name}${creates ? ' y creación de guías' : ''} desde un contrato REST unificado, con estado canónico y webhooks firmados.`,
      provider: { '@id': 'https://tracking-peru.com/#organization' },
      areaServed: { '@type': 'Country', name: 'Perú' },
      ...(cat && cat.total > 0
        ? {
            // El catálogo de agencias, como área de servicio cuantificada. Sale de
            // la misma medición que la tabla de cobertura de más abajo.
            serviceOutput: {
              '@type': 'Thing',
              name: `Catálogo de ${cat.total} agencias de ${c.name}`,
            },
          }
        : {}),
    },
  ],
}
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <Nav />

  <main id="content" class="mx-auto max-w-7xl border-x border-line bg-ink">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <p class="font-mono text-xs text-zinc-600">
        <a href="/couriers" class="transition-colors hover:text-zinc-300">Couriers</a>
        <span class="mx-1.5 text-zinc-700">/</span>
        <span class="text-zinc-400">{c.id}</span>
      </p>

      <h1 class="mt-4 text-balance font-display text-4xl font-semibold tracking-tight text-zinc-50">
        API de rastreo de {c.name}
      </h1>

      <p class="mt-5 text-pretty text-lg leading-relaxed text-zinc-400">
        {
          tracks
            ? `Rastrea envíos de ${c.name} con el mismo contrato que el resto de couriers peruanos: un estado canónico, el literal original adjunto y webhooks firmados cuando el envío cambia.`
            : `Todavía no rastreamos envíos de ${c.name}, y acá está el motivo exacto. Lo que sí funciona hoy y qué falta para lo demás.`
        }
      </p>

      {/* El estado real primero. Es lo que vino a saber quien llegó buscando
          este courier, y esconderlo bajo un pitch sería el tipo de página que
          esta no quiere ser.

          Las dos tarjetas eran divs sin encabezado: se veían como secciones pero
          no lo eran, así que ni el índice del navegador ni un extractor de pasajes
          podían alcanzarlas. Ahora cuelgan de un H2 y cada una tiene su H3. */}
      <h2 class="mt-10 font-display text-xl font-semibold tracking-tight text-zinc-50">
        Qué funciona hoy con {c.name}
      </h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-line bg-ink-soft p-5">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="font-sans text-sm font-medium text-zinc-200">Rastreo de envíos</h3>
            <span
              class:list={[
                'font-mono text-xs',
                tracks ? 'text-[var(--color-live)]' : 'text-[var(--color-partial)]',
              ]}
            >
              {tracks ? 'operativo' : 'en curso'}
            </span>
          </div>
          <p class="mt-2 text-pretty text-sm leading-relaxed text-zinc-500">{c.tracking.note}</p>
        </div>

        <div class="rounded-2xl border border-line bg-ink-soft p-5">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="font-sans text-sm font-medium text-zinc-200">Catálogo de agencias</h3>
            <span
              class:list={[
                'font-mono text-xs',
                hasCatalog ? 'text-[var(--color-live)]' : 'text-zinc-600',
              ]}
            >
              {hasCatalog ? `${c.agencies.total} puntos` : 'no publica'}
            </span>
          </div>
          <p class="mt-2 text-pretty text-sm leading-relaxed text-zinc-500">{c.agencies.note}</p>
        </div>
      </div>

      {
        tracks && (
          <div class="mt-10">
            <h2 class="font-display text-xl font-semibold tracking-tight text-zinc-50">
              Cómo se consulta una guía de {c.name}
            </h2>
            <p class="mt-2 text-pretty text-sm leading-relaxed text-zinc-400">
              {detectionNote[c.detection]}
            </p>
            <div class="mt-4">
              <CodeBlock title={`GET /v1/tracking · ${c.id}`} code={curl} lang="bash" tone="brand" />
            </div>
            {c.requiresCode && (
              <p class="mt-3 text-pretty text-xs leading-relaxed text-[var(--color-partial)]">
                <strong class="font-semibold text-[var(--color-partial)]">{c.name} pide un segundo factor:</strong>{' '}
                además del número de guía, el <code class="font-mono">code</code> (código de orden) que
                figura en el comprobante del envío. Es credencial —prueba que el envío es tuyo—, y sin él
                el rastreo responde <code class="font-mono">422</code>.
              </p>
            )}
            <p class="mt-3 text-pretty text-xs leading-relaxed text-zinc-600">
              El formato exacto de guía de {c.name} lo publica{' '}
              <code class="font-mono text-zinc-400">GET /v1/carriers</code> en{' '}
              <code class="font-mono text-zinc-400">id_format</code>
              {c.requiresCode && (
                <> y <code class="font-mono text-zinc-400">requires_code</code></>
              )}, junto con un ejemplo real. No lo escribimos acá para que no envejezca en dos lugares.
            </p>
          </div>
        )
      }

      {/* Crear guías. El eje que más diferencia a un courier de otro: dos de los
          cinco lo soportan, con credenciales y modalidades de entrega distintas.
          Cuando NO se puede, el motivo concreto también informa —y es lo que
          alguien que evalúa vino a averiguar—, así que la sección se pinta
          siempre, no sólo en el caso feliz. */}
      <div class="mt-10">
        <h2 class="font-display text-xl font-semibold tracking-tight text-zinc-50">
          Crear guías con {c.name}
        </h2>

        {
          creates ? (
            <>
              <p class="mt-2 text-pretty text-sm leading-relaxed text-zinc-400">
                Además de rastrear, el API genera guías de {c.name} con{' '}
                <code class="font-mono text-zinc-300">POST /v1/shipments</code>. {c.shipping.note}
              </p>

              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div class="rounded-xl border border-line p-5">
                  <p class="text-xs text-zinc-600">Con qué credencial</p>
                  <p class="mt-1 font-mono text-sm text-zinc-200">{c.shipping.auth}</p>
                  {c.shipping.auth && (
                    <p class="mt-1.5 text-pretty text-sm leading-relaxed text-zinc-500">
                      {authNote[c.shipping.auth]}
                    </p>
                  )}
                </div>

                <div class="rounded-xl border border-line p-5">
                  <p class="text-xs text-zinc-600">Dónde puede terminar el envío</p>
                  <p class="mt-1 font-mono text-sm text-zinc-200">
                    {c.shipping.delivery.map((d) => deliveryLabel[d]).join(' · ')}
                  </p>
                  <p class="mt-1.5 text-pretty text-sm leading-relaxed text-zinc-500">
                    {c.shipping.delivery.length === 1
                      ? `${c.name} sólo admite ${deliveryLabel[c.shipping.delivery[0]!]}: si tu tienda promete la otra modalidad, no la cubre este courier.`
                      : `${c.name} admite las dos modalidades, así que el destino lo decide tu checkout y no el courier.`}
                  </p>
                </div>
              </div>

              <p class="mt-3 text-pretty text-xs leading-relaxed text-zinc-600">
                Evidencia de la creación: <code class="font-mono text-zinc-400">{c.shipping.level}</code> —{' '}
                {LEVELS[c.shipping.level].detail} Es un nivel INDEPENDIENTE del de rastreo: son dos
                integraciones distintas, contra backends distintos de {c.name}.
              </p>
            </>
          ) : (
            <p class="mt-2 text-pretty text-sm leading-relaxed text-zinc-400">
              Todavía no. {c.shipping.note} El rastreo de {c.name}
              {tracks ? ' sí funciona' : ' tampoco'}, y son integraciones separadas: que no se
              pueda crear una guía no dice nada sobre la otra.
            </p>
          )
        }
      </div>

      {/* Cobertura. Todo lo de acá sale de /v1/agencies medido en build, no de una
          lista paralela: es lo que de verdad distingue a un catálogo de otro.
          La tabla es una <table> de verdad y no una grilla de divs a propósito —
          una tabla se puede leer, citar y copiar; una grilla de divs no. */}
      {
        cat && cat.total > 0 && (
          <div class="mt-10">
            <h2 class="font-display text-xl font-semibold tracking-tight text-zinc-50">
              Cobertura de {c.name}: {cat.total} agencias
            </h2>

            <p class="mt-2 text-pretty text-sm leading-relaxed text-zinc-400">
              {cat.departments > 0
                ? `El catálogo de ${c.name} nombra ${cat.total} puntos repartidos en ${cat.departments} departamento${cat.departments === 1 ? '' : 's'}${cat.departments >= 25 ? ', o sea el país entero' : ''}. Estos son los de mayor concentración:`
                : `${c.name} publica ${cat.total} puntos, pero no dice en qué departamento está cada uno: la dirección llega como una sola cadena sin estructurar.`}
            </p>

            {cat.top.length > 0 && (
              <table class="mt-4 w-full border-collapse text-sm">
                <thead>
                  <tr class="border-b border-line text-left">
                    <th scope="col" class="py-2 pr-4 font-medium text-zinc-400">Departamento</th>
                    <th scope="col" class="py-2 text-right font-medium text-zinc-400">Puntos</th>
                    <th scope="col" class="py-2 pl-4 text-right font-medium text-zinc-400">
                      Del total
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {cat.top.map((d) => (
                    <tr class="border-b border-line/60">
                      <td class="py-2 pr-4 text-zinc-300">{d.name}</td>
                      <td class="py-2 text-right font-mono tabular-nums text-zinc-300">
                        {d.count}
                      </td>
                      <td class="py-2 pl-4 text-right font-mono tabular-nums text-zinc-500">
                        {pct(d.count / cat.total)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}

            <h3 class="mt-8 font-display text-base font-semibold tracking-tight text-zinc-200">
              Qué publica cada punto de {c.name}
            </h3>
            <dl class="mt-3 divide-y divide-line/60 border-y border-line/60 text-sm">
              {(
                [
                  [
                    'Ubigeo INEI',
                    cat.ubigeoRate >= 0.99
                      ? 'en todos los puntos, a nivel distrito'
                      : cat.ubigeoRate > 0
                        ? `en el ${pct(cat.ubigeoRate)} de los puntos`
                        : 'no lo publica',
                  ],
                  [
                    'Coordenadas',
                    cat.geoRate >= 0.999
                      ? 'en todos los puntos'
                      : `en el ${pct(cat.geoRate)} de los puntos`,
                  ],
                  [
                    'Horario',
                    cat.hoursRate >= 0.999
                      ? 'en franjas parseadas'
                      : cat.hoursRate >= 0.5
                        ? `en franjas parseadas en el ${pct(cat.hoursRate)}`
                        : 'en texto libre, sin parsear',
                  ],
                  [
                    'Servicios por punto',
                    cat.services.length ? cat.services.join(', ') : 'no los publica',
                  ],
                  [
                    'Tipo de punto',
                    cat.kinds.length > 1
                      ? cat.kinds.map((k) => `${k.name} (${k.count})`).join(', ')
                      : 'no lo distingue',
                  ],
                ] as const
              ).map(([k, v]) => (
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-2.5">
                  <dt class="text-zinc-500">{k}</dt>
                  <dd class="text-right text-zinc-300">{v}</dd>
                </div>
              ))}
            </dl>

            {cat.syncedAt && (
              <p class="mt-3 text-pretty text-xs leading-relaxed text-zinc-600">
                Catálogo de {c.name} sincronizado el {cat.syncedAt}. Estas cifras se miden contra{' '}
                <code class="font-mono text-zinc-400">GET /v1/agencies</code> en cada despliegue, así
                que no envejecen acá sin envejecer también en el API.
              </p>
            )}
          </div>
        )
      }

      <div class="mt-10">
        <h2 class="font-display text-xl font-semibold tracking-tight text-zinc-50">
          Evidencia y webhooks de {c.name}
        </h2>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-line p-5">
          <h3 class="text-xs font-normal text-zinc-600">Nivel de evidencia</h3>
          <p class="mt-1 font-mono text-sm text-zinc-200">{c.level}</p>
          <p class="mt-1.5 text-pretty text-sm leading-relaxed text-zinc-500">
            {LEVELS[c.level].detail}
          </p>
        </div>
        <div class="rounded-xl border border-line p-5">
          <h3 class="text-xs font-normal text-zinc-600">Webhooks</h3>
          <p class="mt-1 font-mono text-sm text-zinc-200">
            {c.subscribable ? 'suscribible' : 'todavía no'}
          </p>
          <p class="mt-1.5 text-pretty text-sm leading-relaxed text-zinc-500">
            {
              c.subscribable
                ? `Suscribes un envío de ${c.name} y te avisamos con un POST firmado cada vez que cambia de estado.`
                : 'El alta de suscripción lo rechaza en el POST, con el motivo. No dejamos crear una que nunca iba a entregar nada.'
            }
          </p>
        </div>
      </div>
      </div>

      {/* Fuertes y límites. Las dos listas salen de `fuertes` y `limites`, que se
          calculan arriba a partir de lo medido. Nada se redacta a mano, así que
          ningún courier puede terminar diciendo lo mismo que otro — y el día que
          uno mejore su catálogo, su frase cambia sola.

          Los límites van DESPUÉS y completos, no escondidos: es la misma decisión
          que toma la portada al publicar el nivel de evidencia de cada uno. Quien
          está evaluando viene justamente a esto, y enterarse integrando es peor. */}
      {
        fuertes.length > 0 && (
          <div class="mt-10">
            <h2 class="font-display text-xl font-semibold tracking-tight text-zinc-50">
              Cuándo elegir {c.name}
            </h2>
            <ul class="mt-3 space-y-2.5">
              {fuertes.map((f) => (
                <li class="flex gap-3 text-pretty text-sm leading-relaxed text-zinc-400">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--color-live)]" aria-hidden="true" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        limites.length > 0 && (
          <div class="mt-10">
            <h2 class="font-display text-xl font-semibold tracking-tight text-zinc-50">
              Limitaciones conocidas de {c.name}
            </h2>
            <ul class="mt-3 space-y-2.5">
              {limites.map((l) => (
                <li class="flex gap-3 text-pretty text-sm leading-relaxed text-zinc-400">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--color-partial)]" aria-hidden="true" />
                  <span>{l}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {/* Las preguntas. Van a la vista y no sólo en el JSON-LD: marcar como
          FAQPage algo que el visitante no puede leer es lo que las guías de datos
          estructurados prohíben de frente. Y el formato pregunta-respuesta es el
          que mejor se extrae — se cita entero, sin necesitar el resto de la
          página. */}
      {
        faqs.length > 0 && (
          <div class="mt-10">
            <h2 class="font-display text-xl font-semibold tracking-tight text-zinc-50">
              Preguntas frecuentes sobre {c.name}
            </h2>
            <dl class="mt-4 divide-y divide-line/60 border-y border-line/60">
              {faqs.map((f) => (
                <div class="py-4">
                  <dt>
                    <h3 class="text-pretty font-display text-base font-semibold text-zinc-100">
                      {f.q}
                    </h3>
                  </dt>
                  <dd class="mt-2 text-pretty text-sm leading-relaxed text-zinc-400">{f.a}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }

      <div class="mt-12 rounded-2xl border border-brand/30 bg-brand/[0.04] p-6">
        <p class="font-display text-lg font-semibold text-zinc-50">
          Empieza gratis
        </p>
        <p class="mt-1.5 text-pretty text-sm leading-relaxed text-zinc-400">
          El plan Free no vence ni pide tarjeta: {FREE.webhooks} envíos vigilados a la vez y
          1.000 consultas al mes. Cubre {c.name} y los otros {PUBLISHED_CARRIERS.length - 1}{' '}
          couriers — {METRICS.agenciesSynced} agencias sincronizadas incluidas.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="/#get-started"
            class="btn btn-primary rounded-lg px-5 py-2.5 font-medium"
          >
            Crear mi key gratis
          </a>
          <a
            href="/docs"
            class="btn btn-secondary rounded-lg px-5 py-2.5 font-medium"
          >
            Ver la documentación
          </a>
        </div>
      </div>

      {/* Enlaces a los otros. Un buscador descubre páginas siguiendo enlaces, y
          además le da al lector la comparación que vino a hacer. */}
      <div class="mt-14 border-t border-line pt-8">
        <h2 class="text-sm font-medium text-zinc-300">
          <a href="/couriers" class="transition-colors hover:text-zinc-100">Los otros couriers</a>
        </h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            PUBLISHED_CARRIERS.filter((o) => o.id !== c.id).map((o) => (
              <li>
                <a
                  href={`/couriers/${o.id}`}
                  class="inline-block rounded-lg border border-line px-3 py-1.5 text-sm text-zinc-400 transition-colors hover:border-zinc-600 hover:text-zinc-100"
                >
                  {o.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </main>

  <Footer />

</Base>

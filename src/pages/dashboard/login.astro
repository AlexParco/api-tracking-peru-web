---
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import LoginScreen from '../../components/LoginScreen.astro'

/* El aterrizaje del enlace inválido.
 *
 * El API arma su redirect como `DASHBOARD_URL + "/login?error=invalid_link"`, o
 * sea `tracking-peru.com/dashboard/login`. Sin esta ruta, quien abre un enlace
 * vencido cae en un 404 — el peor final posible para alguien que sólo quería
 * entrar. Es la MISMA pantalla que /login: un componente, dos rutas. */
---

<Base title="Entrar — API Tracking Perú" description="Entra a tu panel con un enlace que te llega por correo." noindex>
  <Nav />
  <LoginScreen />
  <Footer />
</Base>

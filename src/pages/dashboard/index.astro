---
import PanelLayout from '../../components/panel/PanelLayout.astro'
import PanelCard from '../../components/panel/PanelCard.astro'

/* El resumen: lo que alguien que entra una vez al mes necesita ver primero.
 *
 * Todo sale de `/account/me` y `/account/errors` — las dos únicas cosas que el
 * panel puede leer con la cookie de sesión. Lo que no venga de ahí, no está.
 */
const stat = 'flex min-w-0 flex-col border border-line bg-ink p-5'
---

<PanelLayout title="Resumen" heading="Resumen" description="Tu key, tu consumo del mes y los últimos errores que te respondió el API.">
  <a slot="actions" href="/docs" class="btn btn-secondary px-4 py-2.5 text-sm font-medium">Ver la documentación</a>

  {/* ── Lo que requiere atención ── */}
  <PanelCard title="Requiere atención">
    <ul class="grid gap-3">
      <li data-alerta="key-inactiva" hidden class="flex flex-col gap-3 border-l-4 border-[var(--color-partial)] bg-ink-soft px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
        <span>
          <span class="eyebrow block text-[var(--color-partial)]">API key</span>
          <span class="mt-1 block font-medium text-zinc-50">Tu key está inactiva: toda llamada responde 401.</span>
        </span>
        <a href="/dashboard/key" class="btn btn-secondary shrink-0 px-3 py-2 text-center text-xs font-medium">Generar una nueva</a>
      </li>
      <li data-alerta="key-sin-usar" hidden class="flex flex-col gap-3 border-l-4 border-zinc-50 bg-ink-soft px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
        <span>
          <span class="eyebrow block text-zinc-500">Primeros pasos</span>
          <span class="mt-1 block font-medium text-zinc-50">Tu key todavía no hizo ninguna llamada.</span>
        </span>
        <a href="/docs#first-call" class="btn btn-primary shrink-0 px-3 py-2 text-center text-xs font-medium">Hacer el primer llamado</a>
      </li>
      <li data-alerta="cupo" hidden class="flex flex-col gap-3 border-l-4 border-[var(--color-partial)] bg-ink-soft px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
        <span>
          <span class="eyebrow block text-[var(--color-partial)]">Consumo</span>
          <span class="mt-1 block font-medium text-zinc-50">Vas por el <span data-campo="pct-alerta"></span> % de tu tope mensual.</span>
          <span class="block text-sm text-zinc-400">Al llegar al tope, las consultas responden 429 hasta el mes siguiente.</span>
        </span>
        <a href="/dashboard/plan" class="btn btn-secondary shrink-0 px-3 py-2 text-center text-xs font-medium">Ver el plan</a>
      </li>
      <li data-alerta="errores" hidden class="flex flex-col gap-3 border-l-4 border-[var(--color-partial)] bg-ink-soft px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
        <span class="min-w-0">
          <span class="eyebrow block text-[var(--color-partial)]">Error repetido · <span data-campo="repetido-veces"></span> veces</span>
          <span class="mt-1 block text-pretty font-medium text-zinc-50" data-campo="repetido-msg"></span>
        </span>
        <a href="/dashboard/errors" class="btn btn-secondary shrink-0 px-3 py-2 text-center text-xs font-medium">Ver errores</a>
      </li>
      <li data-alerta="ok" hidden class="on-lime px-4 py-4">
        <span class="font-display text-xl font-bold">✓ Nada que atender.</span>
        <span class="mt-0.5 block text-sm text-zinc-400">Tu key funciona, no tuviste errores repetidos y tu consumo está holgado.</span>
      </li>
      <li data-alerta="cargando" class="px-4 py-3 text-sm text-zinc-500">Revisando tu cuenta…</li>
    </ul>
  </PanelCard>

  {/* ── Cifras ── */}
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    <div class={stat}>
      <p class="eyebrow text-zinc-500">Consultas del mes</p>
      <p class="mt-3 flex items-baseline gap-2">
        <span class="font-display text-4xl font-semibold tabular-nums tracking-tight text-zinc-50" data-campo="uso">···</span>
        <span class="font-mono text-sm text-zinc-500" data-campo="tope"></span>
      </p>
      <div class="mt-auto pt-4" data-barra hidden>
        <div class="h-2 border border-line"><div class="h-full bg-[#a3e635]" data-campo-barra="uso" style="width:0%"></div></div>
        <p class="mt-1.5 font-mono text-xs text-zinc-500"><span data-campo="pct"></span> % usado</p>
      </div>
    </div>

    <a href="/dashboard/errors" class:list={[stat, 'transition-colors hover:border-zinc-50']}>
      <p class="eyebrow text-zinc-500">Errores recientes</p>
      <p class="mt-3 font-display text-4xl font-semibold tabular-nums tracking-tight text-zinc-50" data-campo="errores-total">···</p>
      <p class="mt-auto pt-4 font-mono text-xs text-zinc-500" data-campo="errores-pie"></p>
    </a>

    <a href="/dashboard/key" class:list={[stat, 'transition-colors hover:border-zinc-50']}>
      <p class="eyebrow text-zinc-500">Tu API key</p>
      <p class="mt-3 font-display text-2xl font-semibold tracking-tight" data-campo="key-estado">···</p>
      <p class="mt-auto pt-4 font-mono text-xs text-zinc-500">último uso <span data-campo="key-uso"></span></p>
    </a>
  </div>

  {/* ── Últimos errores ── */}
  <PanelCard title="Últimos errores" href="/dashboard/errors" hrefLabel="Ver todos" flush>
    <p data-estado="cargando" class="px-5 py-6 text-sm text-zinc-500">Cargando…</p>
    <p data-estado="vacio" hidden class="px-5 py-6 text-zinc-400">
      No tuviste errores. <span class="text-[var(--color-live)]">Todo en orden.</span>
    </p>
    <ul data-estado="lista" hidden class="divide-y divide-line" data-lista-errores></ul>
  </PanelCard>
</PanelLayout>

<script is:inline>
  ;(() => {
    const tp = window.tp
    if (!tp) return

    const esc = (s) =>
      String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c])

    const alerta = (id, on = true) => {
      const el = document.querySelector(`[data-alerta="${id}"]`)
      if (el) el.hidden = !on
    }

    tp.cuenta.then((c) => {
      if (!c) return
      tp.pintar('uso', tp.miles(c.quota_used))
      tp.pintar('tope', c.quota_limit > 0 ? `de ${tp.miles(c.quota_limit)}` : '· sin tope')
      tp.pintar('key-estado', c.key_enabled ? '● Activa' : '○ Inactiva')
      document.querySelectorAll('[data-campo="key-estado"]').forEach((el) => {
        el.classList.add(c.key_enabled ? 'text-[var(--color-live)]' : 'text-[var(--color-partial)]')
      })
      tp.pintar('key-uso', tp.fechaHora(c.key_last_used_at) ?? 'nunca')

      let pct = 0
      if (c.quota_limit > 0) {
        pct = Math.min(100, Math.round((c.quota_used / c.quota_limit) * 100))
        const caja = document.querySelector('[data-barra]')
        caja.hidden = false
        caja.querySelector('[data-campo-barra="uso"]').style.width = `${Math.max(pct, 1)}%`
        tp.pintar('pct', String(pct))
      }

      alerta('cargando', false)
      if (!c.key_enabled) alerta('key-inactiva')
      if (c.key_enabled && !c.key_last_used_at) alerta('key-sin-usar')
      if (pct >= 80) {
        tp.pintar('pct-alerta', String(pct))
        alerta('cupo')
      }
    })

    // Los errores se piden aparte: el resumen muestra los tres últimos y agrupa
    // por código sólo para saber si hay alguno repetido, que es la señal fuerte.
    tp.cargar(() => tp.errores(50), tp.falla).then((data) => {
      if (!data) return
      const items = data.errors ?? []
      tp.pintar('errores-total', String(items.length))

      const porCodigo = new Map()
      for (const e of items) {
        const k = e.code || String(e.status)
        porCodigo.set(k, (porCodigo.get(k) ?? 0) + 1)
      }
      tp.pintar(
        'errores-pie',
        items.length ? `${porCodigo.size} ${porCodigo.size === 1 ? 'tipo' : 'tipos'} · últimos ${items.length}` : 'todo en orden',
      )

      const badge = document.querySelector('[data-badge-errores]')
      if (badge && items.length) {
        badge.textContent = String(items.length)
        badge.hidden = false
      }

      const [codigo, veces] = [...porCodigo.entries()].sort((a, b) => b[1] - a[1])[0] ?? []
      if (veces >= 10) {
        const ej = items.find((e) => (e.code || String(e.status)) === codigo)
        tp.pintar('repetido-veces', String(veces))
        tp.pintar('repetido-msg', ej?.message || codigo)
        document.querySelector('[data-alerta="errores"]').hidden = false
      }

      const lista = document.querySelector('[data-lista-errores]')
      if (!items.length) return tp.estado('vacio')
      lista.innerHTML = items
        .slice(0, 3)
        .map(
          (e) => `<li class="flex items-start gap-4 px-5 py-3.5">
            <span class="mt-0.5 border border-line px-1.5 py-0.5 font-mono text-xs text-zinc-300">${esc(e.status)}</span>
            <span class="min-w-0 flex-1">
              <span class="line-clamp-2 text-sm text-zinc-100">${esc(e.message || e.code)}</span>
              <span class="mt-1 block font-mono text-[11px] text-zinc-500">${esc(e.code)} · ${esc(tp.fechaHora(e.timestamp) ?? '')}</span>
            </span>
          </li>`,
        )
        .join('')
      tp.estado('lista')
    })

    // «Nada que atender» sólo cuando las dos cargas terminaron sin encender nada.
    Promise.allSettled([tp.cuenta]).then(() => {
      setTimeout(() => {
        const alguna = document.querySelector('[data-alerta]:not([hidden]):not([data-alerta="ok"]):not([data-alerta="cargando"])')
        const cargando = document.querySelector('[data-alerta="cargando"]')
        if (cargando && !cargando.hidden) return
        if (!alguna) alerta('ok')
      }, 400)
    })
  })()
</script>

---
import ThemeToggle from './ThemeToggle.astro'
import Logo from './Logo.astro'

/* Fuera de la portada las anclas se anteponen con `/`: un `#api` a secas desde
   /couriers busca el ancla en la página actual y no lleva a ningún lado. */
const atHome = Astro.url.pathname === '/'
const toHome = (anchor: string) => (atHome ? anchor : `/${anchor}`)

const sections = [
  { anchor: '#api', label: 'Integración' },
  { anchor: '#coverage', label: 'Cobertura' },
  { anchor: '#journey', label: 'Estados' },
  { anchor: '#pricing', label: 'Precios' },
]

const path = Astro.url.pathname
const inDocs = path.startsWith('/docs')
const inAccount = ['/login', '/dashboard'].some((p) => path.startsWith(p))
---

{/*
 * La barra es una fila de casilleros: cada destino es una celda con su regla, y
 * el marco de la página sigue por los costados. La acción de cuenta va en la
 * última celda, en tinta invertida —no en lima—, para no competir con el
 * primario del hero.
 *
 * El menú móvil es `<details>`: abre y cierra sin JavaScript, con teclado y
 * lector de pantalla. El script de abajo sólo agrega el cierre por conveniencia.
 */}
<header class="sticky top-0 z-40 bg-ink-soft/85 backdrop-blur">
  <nav
    class="relative mx-auto flex h-14 max-w-7xl items-stretch border-x border-b border-line bg-ink"
    aria-label="Principal"
  >
    <a
      href="/"
      class="flex min-w-0 items-center gap-2.5 border-r border-line px-4 font-semibold tracking-tight text-zinc-50 sm:px-5"
    >
      <span class="chip-lime grid size-7 shrink-0 place-items-center">
        <Logo size={16} />
      </span>
      <span class="truncate">API Tracking <span class="text-zinc-500">Perú</span></span>
    </a>

    <div class="hidden items-stretch lg:flex">
      {
        sections.map((s) => (
          <a
            href={toHome(s.anchor)}
            class="eyebrow flex items-center border-r border-line px-5 text-zinc-500 transition-colors hover:bg-[var(--hover-soft)] hover:text-zinc-50"
          >
            {s.label}
          </a>
        ))
      }
    </div>

    <div class="ml-auto hidden items-stretch md:flex">
      <a
        href="/docs"
        aria-current={inDocs ? 'page' : undefined}
        class:list={[
          'eyebrow flex items-center border-l border-line px-5 transition-colors hover:bg-[var(--hover-soft)]',
          inDocs ? 'text-brand' : 'text-zinc-500 hover:text-zinc-50',
        ]}
      >
        Docs
      </a>
      <div class="flex items-center border-l border-line px-4">
        <ThemeToggle />
      </div>
      <a
        href="/login"
        aria-current={inAccount ? 'page' : undefined}
        class:list={[
          'eyebrow flex items-center border-l border-line px-5 transition-colors hover:bg-[var(--hover-soft)]',
          inAccount ? 'text-brand' : 'text-zinc-500 hover:text-zinc-50',
        ]}
      >
        Entrar
      </a>
      <a
        href={toHome('#get-started')}
        class="flex items-center gap-2 border-l border-line bg-zinc-50 px-5 text-sm font-medium text-ink transition-colors hover:bg-[#a3e635] hover:text-[#08090b]"
      >
        Pedir acceso <span aria-hidden="true">→</span>
      </a>
    </div>

    <details id="menu" class="menu ml-auto flex shrink-0 md:ml-0 lg:hidden">
      <summary
        class="grid h-full w-14 cursor-pointer place-items-center border-l border-line text-zinc-300 transition-colors hover:bg-[var(--hover-soft)] hover:text-zinc-50"
        aria-label="Menú"
      >
        <svg class="cerrado size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="abierto size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>

      {/* Fondo opaco: un menú que tapa contenido tiene que taparlo. */}
      <div class="panel absolute inset-x-[-1px] top-full border-x border-b border-line bg-ink shadow-xl shadow-black/20">
        <ul class="divide-y divide-line border-b border-line">
          {
            sections.map((s, i) => (
              <li>
                <a
                  href={toHome(s.anchor)}
                  class="flex items-center gap-4 px-5 py-3.5 text-zinc-300 transition-colors hover:bg-[var(--hover-soft)] hover:text-zinc-50"
                >
                  <span class="eyebrow w-5 text-zinc-600">{String(i + 1).padStart(2, '0')}</span>
                  {s.label}
                </a>
              </li>
            ))
          }
          <li class="md:hidden">
            <a
              href="/docs"
              aria-current={inDocs ? 'page' : undefined}
              class:list={[
                'flex items-center gap-4 px-5 py-3.5 transition-colors hover:bg-[var(--hover-soft)]',
                inDocs ? 'text-brand' : 'text-zinc-300 hover:text-zinc-50',
              ]}
            >
              <span class="eyebrow w-5 text-zinc-600">→</span>
              Documentación
            </a>
          </li>
          <li class="md:hidden">
            <a
              href="/login"
              class="flex items-center gap-4 px-5 py-3.5 text-zinc-300 transition-colors hover:bg-[var(--hover-soft)] hover:text-zinc-50"
            >
              <span class="eyebrow w-5 text-zinc-600">→</span>
              Entrar a mi cuenta
            </a>
          </li>
        </ul>

        <div class="flex items-center gap-3 p-4 md:hidden">
          <a
            href={toHome('#get-started')}
            class="btn btn-primary block flex-1 px-4 py-3 text-center text-sm font-medium"
          >
            Pedir acceso
          </a>
          <div class="grid size-11 place-items-center border border-line">
            <ThemeToggle id="tema-menu" />
          </div>
        </div>
      </div>
    </details>
  </nav>
</header>

<script is:inline>
  ;(() => {
    const menu = document.getElementById('menu')
    if (!menu) return
    menu.addEventListener('click', (e) => {
      if (e.target.closest('a')) menu.removeAttribute('open')
    })
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') menu.removeAttribute('open')
    })
    addEventListener('click', (e) => {
      if (menu.hasAttribute('open') && !menu.contains(e.target)) menu.removeAttribute('open')
    })
  })()
</script>

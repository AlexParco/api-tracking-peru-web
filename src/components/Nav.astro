---
import Logo from './Logo.astro'

/* Los links de sección son anclas de la portada. Desde /docs, un `#api` a
   secas no lleva a ningún lado: busca el anchor en la página current, no la
   encuentra y no pasa nada — el usuario hace clic y el sitio parece roto.
   Fuera de la portada se les antepone `/` para que vuelvan a ella. */
const atHome = Astro.url.pathname === '/'
const toHome = (anchor: string) => (atHome ? anchor : `/${anchor}`)

const sections = [
  { anchor: '#cobertura', label: 'Cobertura' },
  { anchor: '#api', label: 'Integración' },
  { anchor: '#journey', label: 'Estados' },
  { anchor: '#precios', label: 'Precios' },
]

const inDocs = Astro.url.pathname.startsWith('/docs')
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-ink/80 backdrop-blur">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6" aria-label="Principal">
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight text-zinc-100">
      <span class="grid size-6 shrink-0 place-items-center rounded-md bg-brand text-ink">
        <Logo size={15} />
      </span>
      API Tracking <span class="text-zinc-500">Perú</span>
    </a>

    <div class="hidden items-center gap-7 text-sm text-zinc-400 md:flex">
      {
        sections.map((s) => (
          <a href={toHome(s.anchor)} class="transition-colors hover:text-zinc-100">
            {s.label}
          </a>
        ))
      }
    </div>

    {/* «Docs» salió de los enlaces de sección: no es una sección de esta página,
        es otra página. Va como botón secundario junto a la acción principal —el
        contorno contra el relleno blanco deja claro cuál es cuál sin que ninguno
        desaparezca.

        `aria-current` y no solo el color: quien navega por lectura de pantalla
        también tiene que saber en qué página está. */}
    <div class="flex items-center gap-2">
      <a
        href="/docs"
        aria-current={inDocs ? 'page' : undefined}
        class:list={[
          'rounded-lg border px-3.5 py-1.5 text-sm font-medium transition-colors',
          inDocs
            ? 'border-brand/40 bg-brand/10 text-brand'
            : 'border-line text-zinc-300 hover:border-zinc-600 hover:text-zinc-100',
        ]}
      >
        Docs
      </a>
      <a
        href={toHome('#empezar')}
        class="rounded-lg bg-zinc-100 px-3.5 py-1.5 text-sm font-medium text-ink transition-colors hover:bg-white"
      >
        Pedir acceso
      </a>
    </div>
  </nav>
</header>

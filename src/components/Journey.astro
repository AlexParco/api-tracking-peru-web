---
import SectionHead from './SectionHead.astro'
import { JOURNEY, DETOURS, PUBLISHED_CARRIERS } from '../data/api.ts'

// Derivado, no escrito a mano: este párrafo ya nació viejo una vez.
const tracking = PUBLISHED_CARRIERS.filter((c) => c.tracking.status === 'ok')
const awaitingEvidence = PUBLISHED_CARRIERS.filter(
  (c) => c.tracking.status === 'pendiente' && c.agencies.status === 'ok',
)
const listNames = (cs: typeof PUBLISHED_CARRIERS) =>
  cs.length < 2
    ? cs.map((c) => c.name).join('')
    : `${cs.slice(0, -1).map((c) => c.name).join(', ')} y ${cs[cs.length - 1].name}`
---

<section id="journey" class="scroll-mt-14 border-t border-line pt-20 md:pt-28">
  <SectionHead n="05" kicker="Estados" title="Un envío, once estados, un solo vocabulario">
    Cada courier nombra los hitos a su manera y ninguno usa los mismos. Este es el
    recorrido al que los traducimos —el mismo para los cinco—, con el literal original
    siempre adjunto en <code class="font-mono text-sm text-zinc-200">status_raw</code>.
  </SectionHead>

  {/* El recorrido como mapa de ruta: una vía y seis paraderos. Lista ordenada de
      verdad, porque el orden ES el contenido. El CSS de `.journey-*` en
      `global.css` lo pone vertical en teléfono y horizontal desde `md`. */}
  <div class="mt-16 border-t border-line px-5 py-12 sm:px-8 lg:px-12 lg:py-16">
    <ol
      class="journey relative grid gap-10 md:grid-cols-6 md:gap-5"
      data-reveal="fade"
      style={`--step: 2; --steps: ${JOURNEY.length}`}
    >
      <span class="journey-track" aria-hidden="true"></span>
      <span class="journey-trail" aria-hidden="true"></span>

      {
        JOURNEY.map((h, i) => (
          <li class="journey-step" data-step style={`--step: ${i}`}>
            <span class="journey-dot" data-last={i === JOURNEY.length - 1} aria-hidden="true" />
            <span class="eyebrow block text-zinc-600">{String(i + 1).padStart(2, '0')}</span>
            <span class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-1">
              {h.states.map((e, j) => (
                <>
                  {j > 0 && <span class="font-mono text-[10px] text-zinc-600">o</span>}
                  <code class="break-all font-mono text-sm font-semibold text-zinc-50">{e}</code>
                </>
              ))}
            </span>
            <p class="mt-2 text-pretty text-sm leading-relaxed text-zinc-500">{h.title}</p>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="grid border-t border-line lg:grid-cols-2" data-reveal>
    <div class="border-b border-line px-5 py-10 sm:px-8 lg:border-b-0 lg:border-r lg:px-12">
      <h3 class="eyebrow text-zinc-500">De su palabra a la nuestra</h3>
      <p class="mt-4 text-pretty text-sm leading-relaxed text-zinc-400">
        Validados contra respuestas reales: {tracking.length} de{' '}
        {PUBLISHED_CARRIERS.length} couriers ({listNames(tracking)}).
        {awaitingEvidence.length > 0 && (
          <> {listNames(awaitingEvidence)} siguen pendientes — no agregamos estados
          estimados mientras no lleguen sus respuestas.</>
        )}
      </p>

      <ul class="mt-6 border-t border-line">
        {
          JOURNEY.filter((h) => h.literal).map((h) => (
            <li class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 border-b border-line py-3 font-mono text-sm">
              <span class="min-w-0">
                <span class="eyebrow block text-zinc-600">{h.literal!.carrier} devolvió</span>
                <span class="mt-1 block truncate text-zinc-200">"{h.literal!.raw}"</span>
              </span>
              <span class="text-zinc-600" aria-hidden="true">→</span>
              <span class="min-w-0 text-right">
                <span class="eyebrow block text-zinc-600">status</span>
                <span class="marker mt-1 inline-block font-semibold">{h.states[0]}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="px-5 py-10 sm:px-8 lg:px-12">
      <h3 class="eyebrow text-zinc-500">Y los que se salen del camino</h3>
      <dl class="mt-6 border-t border-line">
        {
          DETOURS.map((d) => (
            <div class="grid gap-1 border-b border-line py-3 sm:grid-cols-[9rem_1fr] sm:gap-4">
              <dt>
                <code class="border border-line px-1.5 py-0.5 font-mono text-xs font-semibold text-zinc-100">{d.status}</code>
              </dt>
              <dd class="text-sm leading-relaxed text-zinc-500">{d.note}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

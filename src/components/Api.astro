---
import CodeBlock from './CodeBlock.astro'
import { ENDPOINTS, EJEMPLO_TRACKING, ESTADOS_CANONICOS } from '../data/api.ts'

const metodoClase: Record<string, string> = {
  GET: 'text-[var(--color-live)]',
  POST: 'text-sky-400',
  DELETE: 'text-rose-400',
}
---

<section id="api" class="border-t border-line py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="max-w-2xl text-balance font-display text-3xl font-semibold tracking-tight text-zinc-50 md:text-4xl">
      Una respuesta, sin importar el courier
    </h2>
    <p class="mt-4 max-w-2xl text-pretty leading-relaxed text-zinc-400">
      El mismo <code class="font-mono text-sm text-zinc-300">Shipment</code> para todos:
      estado canónico, timeline ordenado con zona horaria explícita, partes, bultos y
      pago. Y el literal del courier siempre adjunto en
      <code class="font-mono text-sm text-zinc-300">status_raw</code>, porque normalizar
      no debería significar perder el dato original.
    </p>

    <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:items-start">
      <div>
        <ul class="divide-y divide-line/60 border-y border-line/60">
          {
            ENDPOINTS.map((e) => (
              <li class:list={['py-3.5', e.destacado && 'bg-brand/[0.04]']}>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class:list={['font-mono text-xs font-semibold', metodoClase[e.metodo]]}>
                    {e.metodo}
                  </span>
                  <code class="font-mono text-sm text-zinc-200">{e.ruta}</code>
                </div>
                <p class="mt-1 text-sm leading-relaxed text-zinc-500">{e.resumen}</p>
              </li>
            ))
          }
        </ul>

        <div class="mt-8">
          <h3 class="text-sm font-medium text-zinc-300">Los 11 estados canónicos</h3>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {
              ESTADOS_CANONICOS.map((s) => (
                <li class="rounded border border-line bg-ink-soft px-2 py-1 font-mono text-xs text-zinc-400">
                  {s}
                </li>
              ))
            }
          </ul>
          <p class="mt-3 max-w-md text-xs leading-relaxed text-zinc-600">
            <code class="text-zinc-400">available_for_pickup</code> existe porque en Perú
            el retiro en agencia es la norma, no la excepción, y decir «en reparto» cuando
            nadie está repartiendo es falso.
            <code class="text-zinc-400">returning</code> no es terminal: un envío que vuelve
            todavía puede entregarse.
          </p>
        </div>
      </div>

      <CodeBlock titulo="200 OK · application/json" codigo={EJEMPLO_TRACKING} tono="brand" />
    </div>
  </div>
</section>

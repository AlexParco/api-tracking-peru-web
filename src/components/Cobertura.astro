---
import { CARRIERS, NIVELES, type Estado } from '../data/api.ts'

const icono: Record<Estado, { simbolo: string; clase: string; texto: string; late: boolean }> = {
  ok: { simbolo: '●', clase: 'text-[var(--color-live)]', texto: 'Operativo', late: true },
  pendiente: { simbolo: '◐', clase: 'text-[var(--color-partial)]', texto: 'En curso', late: false },
  no: { simbolo: '○', clase: 'text-[var(--color-none)]', texto: 'No disponible', late: false },
}

const nivelClase: Record<string, string> = {
  live: 'border-[var(--color-live)]/30 bg-[var(--color-live)]/10 text-[var(--color-live)]',
  code_derived: 'border-[var(--color-partial)]/30 bg-[var(--color-partial)]/10 text-[var(--color-partial)]',
  contract_only: 'border-[var(--color-partial)]/30 bg-[var(--color-partial)]/10 text-[var(--color-partial)]',
  none: 'border-zinc-700 bg-zinc-800/40 text-zinc-500',
}
---

<section id="cobertura" class="border-t border-line py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2
      class="max-w-2xl text-balance font-display text-3xl font-semibold tracking-tight text-zinc-50 md:text-4xl"
      data-revelar
    >
      Qué funciona hoy, sin maquillaje
    </h2>
    <p class="mt-4 max-w-2xl text-pretty leading-relaxed text-zinc-400" data-revelar style="--paso: 1">
      Esta tabla es el estado real, no una hoja de ruta. Un courier en ámbar no está
      «casi listo»: está implementado y esperando algo concreto, y acá dice qué. Lo mismo
      responde <code class="font-mono text-sm text-zinc-300">GET /v1/carriers</code>, así
      que tu código puede leerlo en vez de confiar en esta página.
    </p>

    <div class="mt-10 overflow-x-auto">
      <table class="w-full min-w-[46rem] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-line text-xs uppercase tracking-wider text-zinc-500">
            <th scope="col" class="py-3 pr-4 font-medium">Courier</th>
            <th scope="col" class="py-3 pr-4 font-medium">Rastreo</th>
            <th scope="col" class="py-3 pr-4 font-medium">Agencias</th>
            <th scope="col" class="py-3 font-medium">Verificación</th>
          </tr>
        </thead>
        <tbody>
          {
            CARRIERS.map((c, i) => (
              <tr
                class="fila group/fila border-b border-line/60 align-top"
                data-revelar="fade"
                style={`--paso: ${i}`}
              >
                <td class="py-4 pr-4">
                  <div class="font-medium text-zinc-100">{c.nombre}</div>
                  <div class="mt-0.5 font-mono text-xs text-zinc-600">{c.id}</div>
                </td>

                <td class="py-4 pr-4">
                  <div class="flex items-center gap-2">
                    <span
                      class:list={[icono[c.rastreo.estado].clase, icono[c.rastreo.estado].late && 'late']}
                      aria-hidden="true"
                    >
                      {icono[c.rastreo.estado].simbolo}
                    </span>
                    <span class="sr-only">{icono[c.rastreo.estado].texto}: </span>
                    <span class="text-zinc-400">{c.rastreo.nota}</span>
                  </div>
                </td>

                <td class="py-4 pr-4">
                  <div class="flex items-center gap-2">
                    <span
                      class:list={[icono[c.agencias.estado].clase, icono[c.agencias.estado].late && 'late']}
                      aria-hidden="true"
                    >
                      {icono[c.agencias.estado].simbolo}
                    </span>
                    <span class="sr-only">{icono[c.agencias.estado].texto}: </span>
                    <span class="text-zinc-400">
                      {c.agencias.total !== null && (
                        <span class="font-mono text-zinc-200">{c.agencias.total}</span>
                      )}
                      {c.agencias.total !== null ? ' · ' : ''}
                      {c.agencias.nota}
                    </span>
                  </div>
                </td>

                <td class="py-4">
                  <span
                    class:list={[
                      'inline-block whitespace-nowrap rounded-md border px-2 py-0.5 font-mono text-xs transition-transform duration-200 group-hover/fila:scale-105',
                      nivelClase[c.nivel],
                    ]}
                    title={NIVELES[c.nivel].detalle}
                  >
                    {c.nivel}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-6 max-w-3xl text-sm leading-relaxed text-zinc-500">
      Dos couriers no publican catálogo de agencias y no es una tarea pendiente: uno opera
      recojo puerta a puerta y el otro tiene dos sedes. Decir «próximamente» ahí sería
      inventar un futuro que no depende de nosotros.
    </p>
  </div>
</section>

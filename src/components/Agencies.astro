---
/* El buscador de agencias.
 *
 * Dos modos con el mismo código: sin `PUBLIC_API_URL` filtra en el navegador
 * sobre datos de ejemplo que van en el HTML; con él consulta `GET /v1/agencies`
 * de verdad (producción desde el 2026-08-06), SIN key: el catálogo es público y
 * una key en una página pública está publicada.
 *
 * Sobre la consulta se muestra la URL que se está pidiendo, actualizada en cada
 * tecla. No es adorno: es la línea que el visitante va a escribir en su código.
 */
import SectionHead from './SectionHead.astro'
import { MOCK_AGENCIES } from '../data/agencies-mock.ts'
import { PUBLISHED_CARRIERS } from '../data/api.ts'

/* Una demostración de que el buscador consulta en vivo, no un listado. */
const EN_PORTADA = 6

/* Olva mete la dirección dentro del nombre: no se repite la línea. Sin `export`
   a propósito (Astro sube los export al ámbito del módulo y dejan de verse). */
const norm = (x: string) => (x ?? '').toUpperCase().replace(/\s+/g, ' ').trim()
const repeats = (name: string, address: string) => {
  const a = norm(address)
  return a.length > 0 && norm(name).includes(a)
}

const API = import.meta.env.PUBLIC_API_URL ?? ''
const isLive = API !== ''

const withCatalog = PUBLISHED_CARRIERS.filter((c) => c.agencies.status === 'ok')
const nameOf = new Map(PUBLISHED_CARRIERS.map((c) => [c.id, c.name]))

/** Lo que se ve, se busca: el carrier va adentro del índice con id y nombre. */
const indexOf = (a: (typeof MOCK_AGENCIES)[number]) =>
  [a.carrier, nameOf.get(a.carrier), a.name, a.location.address, a.location.district, a.location.province, a.location.department]
    .filter(Boolean)
    .join(' ')
    .toLowerCase()

const cardClass = 'flex min-w-0 flex-col border-b border-r border-line p-5'
---

<section id="agencias" class="scroll-mt-14 border-t border-line pt-20 md:pt-28">
  <SectionHead n="04" kicker="Agencias" title="Busca una agencia">
    El mismo <code class="font-mono text-sm text-zinc-200">GET /v1/agencies</code> que
    usarías tú, contra los catálogos de los couriers que publican uno. Cada resultado
    dice de dónde salió su ubigeo — y cuándo no lo pudimos resolver.
  </SectionHead>

  <div class="mt-16 border-t border-line px-5 py-10 sm:px-8 lg:px-12">
    {
      !isLive && (
        <p class="mb-6 flex flex-wrap items-baseline gap-x-3 border border-[var(--color-partial)] px-4 py-3 text-sm leading-relaxed text-zinc-400">
          <span class="eyebrow text-[var(--color-partial)]">datos de ejemplo</span>
          <span class="text-pretty">
            El API todavía no está desplegado, así que estas {MOCK_AGENCIES.length} agencias son ficticias y
            están para probar el buscador. No son el catálogo.
          </span>
        </p>
      )
    }

    <div class="grid border border-zinc-50 sm:grid-cols-[minmax(0,1fr)_15rem]" data-reveal>
      <div class="flex min-w-0 items-center">
        <label for="agencias-q" class="eyebrow shrink-0 self-stretch border-r border-line px-4 py-4 text-zinc-500">
          <span class="sr-only">Buscar por distrito, dirección o nombre</span>
          <span aria-hidden="true">q=</span>
        </label>
        <input
          id="agencias-q"
          type="search"
          autocomplete="off"
          placeholder="Distrito, dirección o nombre…"
          data-query
          class="min-w-0 flex-1 bg-transparent px-4 py-4 text-lg text-zinc-50 placeholder:text-zinc-600 focus:outline-none"
        />
      </div>

      {/* Menú propio y no `<select>`: el nativo ignora el tema y lo pinta el
          sistema operativo. El teclado está entero y el valor vive en un input
          oculto, así que el filtro sigue escuchando `change`. */}
      <div class="relative border-t border-zinc-50 sm:border-l sm:border-t-0" data-dropdown>
        <span id="agencias-carrier-label" class="sr-only">Filtrar por courier</span>
        <input type="hidden" data-carrier value="" />

        <button
          type="button"
          id="agencias-carrier"
          role="combobox"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="agencias-carrier-menu"
          aria-labelledby="agencias-carrier-label agencias-carrier"
          data-dropdown-button
          class="flex h-full w-full items-center justify-between gap-2 px-4 py-4 text-left text-zinc-100 transition-colors hover:bg-[var(--hover-soft)] focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand/60"
        >
          <span class="flex min-w-0 items-baseline gap-2">
            <span class="eyebrow text-zinc-500" aria-hidden="true">carrier=</span>
            <span class="truncate" data-dropdown-label>Todos los couriers</span>
          </span>
          <svg class="size-4 shrink-0 text-zinc-500 transition-transform duration-200" data-dropdown-chevron fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="square" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <ul
          id="agencias-carrier-menu"
          role="listbox"
          aria-labelledby="agencias-carrier-label"
          tabindex="-1"
          data-dropdown-menu
          hidden
          class="absolute -left-px -right-px top-full z-30 border border-zinc-50 bg-ink shadow-[8px_8px_0_0_var(--color-line)]"
        >
          {[{ id: '', name: 'Todos los couriers' }, ...withCatalog].map((c, i) => (
            <li
              role="option"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-value={c.id}
              data-dropdown-option
              class="flex cursor-pointer items-center justify-between gap-2 border-b border-line px-4 py-2.5 text-sm text-zinc-300 last:border-b-0"
            >
              <span class="truncate">{c.name}</span>
              <svg class="size-4 shrink-0 text-brand opacity-0" data-dropdown-check fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="square" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-x border-b border-line px-4 py-2.5">
      <code class="min-w-0 break-all font-mono text-xs text-zinc-500">
        <span class="font-semibold text-[var(--color-live)]">GET</span>
        <span data-url>/v1/agencies?per_page={EN_PORTADA}</span>
      </code>
      {/* `polite`: el conteo cambia en cada tecla y no debe interrumpir. */}
      <p class="eyebrow text-zinc-600" data-status aria-live="polite">
        {isLive ? 'consultando…' : `${MOCK_AGENCIES.length} agencias`}
      </p>
    </div>

    {/* Borde por tarjeta (derecha y abajo) y la lista pone arriba e izquierda:
        con resultados impares el hueco queda abierto en vez de pintado como una
        tarjeta vacía. En vivo NO se sirven los ejemplos. */}
    <ul class="mt-6 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-3" data-list>
      {
        (isLive ? [] : MOCK_AGENCIES.slice(0, EN_PORTADA)).map((a) => (
          <li class={cardClass} data-item data-carrier-id={a.carrier} data-search={indexOf(a)}>
            <p class="flex items-center justify-between gap-3">
              <span class="eyebrow border border-line px-1.5 py-0.5 text-zinc-300">{a.carrier}</span>
              {a.location.ubigeo ? (
                <span class="font-mono text-[11px] text-zinc-500">
                  {a.location.ubigeo}<span class="text-zinc-600"> · {a.ubigeo_source}</span>
                </span>
              ) : (
                <span class="font-mono text-[11px] text-[var(--color-partial)]">sin ubigeo</span>
              )}
            </p>
            <p class="mt-4 line-clamp-2 font-medium text-zinc-50">{a.name}</p>
            {!repeats(a.name, a.location.address) && (
              <p class="mt-1 text-sm leading-relaxed text-zinc-500">{a.location.address}</p>
            )}
            {(() => {
              const where = [a.location.district, a.location.province, a.location.department].filter(Boolean).join(' · ')
              return where ? <p class="eyebrow mt-auto pt-4 text-zinc-600">{where}</p> : null
            })()}
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-sm leading-relaxed text-zinc-500" data-empty hidden>
      Ninguna agencia coincide. Prueba con el distrito solo, o quita el filtro de courier.
    </p>
    <p class="mt-6 text-sm leading-relaxed text-[var(--color-partial)]" data-error hidden></p>

    {
      isLive && (
        <noscript>
          <p class="mt-6 max-w-2xl text-pretty text-sm leading-relaxed text-zinc-500">
            El buscador necesita JavaScript. La misma consulta, sin él:
            <code class="scroll-shadow mt-2 block overflow-x-auto border border-line bg-ink-soft p-3 font-mono text-xs text-zinc-300" style="--scroll-bg: var(--color-ink-soft)">
              curl "{API}/v1/agencies?carrier=olva&q=miraflores"
            </code>
          </p>
        </noscript>
      )
    }
  </div>
</section>

<script is:inline define:vars={{ API, EN_PORTADA, cardClass }}>
  ;(() => {
    // `agencias` con A: es el id del `<section>`, parte de la URL pública.
    const seccion = document.getElementById('agencias')
    if (!seccion) return

    const q = seccion.querySelector('[data-query]')
    const carrier = seccion.querySelector('[data-carrier]')
    const urlEl = seccion.querySelector('[data-url]')

    // ── El desplegable propio ──
    ;(() => {
      const root = seccion.querySelector('[data-dropdown]')
      if (!root) return
      const button = root.querySelector('[data-dropdown-button]')
      const menu = root.querySelector('[data-dropdown-menu]')
      const label = root.querySelector('[data-dropdown-label]')
      const chevron = root.querySelector('[data-dropdown-chevron]')
      const options = [...root.querySelectorAll('[data-dropdown-option]')]
      let active = 0
      let open = false

      const paint = () => {
        options.forEach((o, i) => {
          const selected = o.getAttribute('aria-selected') === 'true'
          o.querySelector('[data-dropdown-check]').classList.toggle('opacity-0', !selected)
          o.classList.toggle('bg-[var(--hover-soft)]', i === active)
          o.classList.toggle('text-zinc-50', i === active || selected)
          if (i === active) o.id = 'agencias-carrier-activa'
          else o.removeAttribute('id')
        })
        if (open) button.setAttribute('aria-activedescendant', 'agencias-carrier-activa')
        else button.removeAttribute('aria-activedescendant')
      }

      const show = () => {
        open = true
        menu.hidden = false
        button.setAttribute('aria-expanded', 'true')
        chevron.classList.add('rotate-180')
        active = Math.max(0, options.findIndex((o) => o.getAttribute('aria-selected') === 'true'))
        paint()
      }

      const hide = (focus) => {
        open = false
        menu.hidden = true
        button.setAttribute('aria-expanded', 'false')
        chevron.classList.remove('rotate-180')
        paint()
        if (focus) button.focus()
      }

      const choose = (i) => {
        options.forEach((o, j) => o.setAttribute('aria-selected', String(i === j)))
        label.textContent = options[i].querySelector('span').textContent
        carrier.value = options[i].dataset.value
        active = i
        hide(true)
        carrier.dispatchEvent(new Event('change'))
      }

      const move = (step) => {
        active = (active + step + options.length) % options.length
        paint()
        options[active].scrollIntoView({ block: 'nearest' })
      }

      button.addEventListener('click', () => (open ? hide(false) : show()))
      button.addEventListener('keydown', (e) => {
        if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(e.key)) {
          e.preventDefault()
          if (!open) return show()
          if (e.key === 'ArrowDown') return move(1)
          if (e.key === 'ArrowUp') return move(-1)
          return choose(active)
        }
        if (e.key === 'Escape' && open) {
          e.preventDefault()
          hide(true)
        }
        if (e.key === 'Home' && open) {
          e.preventDefault()
          active = 0
          paint()
        }
        if (e.key === 'End' && open) {
          e.preventDefault()
          active = options.length - 1
          paint()
        }
      })
      options.forEach((o, i) => {
        o.addEventListener('click', () => choose(i))
        o.addEventListener('mousemove', () => {
          if (active !== i) {
            active = i
            paint()
          }
        })
      })
      document.addEventListener('pointerdown', (e) => {
        if (open && !root.contains(e.target)) hide(false)
      }, true)
      paint()
    })()

    const list = seccion.querySelector('[data-list]')
    const estado = seccion.querySelector('[data-status]')
    const empty = seccion.querySelector('[data-empty]')
    const error = seccion.querySelector('[data-error]')
    if (!q || !carrier || !list) return

    const rows = [...list.querySelectorAll('[data-item]')]

    // La URL que se pide, a la vista. Se arma igual en los dos modos.
    const buildUrl = () => {
      const params = new URLSearchParams()
      if (q.value.trim()) params.set('q', q.value.trim())
      if (carrier.value) params.set('carrier', carrier.value)
      params.set('per_page', String(EN_PORTADA))
      if (urlEl) urlEl.textContent = `/v1/agencies?${params}`
      return params
    }

    const count = (mostradas, total = mostradas) => {
      const n = total === 1 ? '1 agencia' : `${total} agencias`
      estado.textContent = total > mostradas ? `${n} · mostrando ${mostradas}` : n
      empty.toggleAttribute('hidden', mostradas !== 0)
    }

    const filterLocal = () => {
      buildUrl()
      const query = q.value.trim().toLowerCase()
      const cual = carrier.value
      let matches = 0
      for (const row of rows) {
        const pasa = (!cual || row.dataset.carrierId === cual) && (!query || row.dataset.search.includes(query))
        row.toggleAttribute('hidden', !pasa)
        if (pasa) matches++
      }
      count(matches)
    }

    let inFlight = null

    const norm = (x) => String(x ?? '').toUpperCase().replace(/\s+/g, ' ').trim()
    const repite = (name, address) => {
      const a = norm(address)
      return a.length > 0 && norm(name).includes(a)
    }

    const escapeHtml = (s) =>
      String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c])

    // Nombre y dirección vienen del courier: texto ajeno, siempre escapado.
    const paint = (agencies) => {
      list.innerHTML = agencies
        .map((a) => {
          const l = a.location ?? {}
          const where = [l.district, l.province, l.department].filter(Boolean).join(' · ')
          const ubigeo = l.ubigeo
            ? `<span class="font-mono text-[11px] text-zinc-500">${escapeHtml(l.ubigeo)}<span class="text-zinc-600"> · ${escapeHtml(a.ubigeo_source)}</span></span>`
            : '<span class="font-mono text-[11px] text-[var(--color-partial)]">sin ubigeo</span>'
          return `<li class="${cardClass}">
            <p class="flex items-center justify-between gap-3">
              <span class="eyebrow border border-line px-1.5 py-0.5 text-zinc-300">${escapeHtml(a.carrier)}</span>
              ${ubigeo}
            </p>
            <p class="mt-4 line-clamp-2 font-medium text-zinc-50">${escapeHtml(a.name)}</p>
            ${repite(a.name, l.address) ? '' : `<p class="mt-1 text-sm leading-relaxed text-zinc-500">${escapeHtml(l.address)}</p>`}
            ${where ? `<p class="eyebrow mt-auto pt-4 text-zinc-600">${escapeHtml(where)}</p>` : ''}
          </li>`
        })
        .join('')
    }

    /* El esqueleto reproduce la forma de la tarjeta real, así lo que llega
       después ocupa el mismo sitio y la lista no salta. */
    const anchos = [
      ['w-14', 'w-3/4', 'w-full', 'w-24'],
      ['w-12', 'w-2/3', 'w-5/6', 'w-28'],
      ['w-16', 'w-4/5', 'w-3/5', 'w-20'],
    ]
    let mostradoEn = 0
    const skeleton = (n) => {
      mostradoEn = performance.now()
      list.setAttribute('aria-busy', 'true')
      list.innerHTML = Array.from({ length: n }, (_, i) => {
        const [c, nom, dir, pie] = anchos[i % anchos.length]
        return `<li class="${cardClass}" aria-hidden="true">
          <p class="flex items-center justify-between"><span class="skel h-4 ${c}"></span><span class="skel h-3 w-16"></span></p>
          <p class="mt-4 skel h-4 ${nom}"></p>
          <p class="mt-2.5 skel h-3 ${dir}"></p>
          <p class="mt-5 skel h-3 ${pie}"></p>
        </li>`
      }).join('')
    }

    const query = async () => {
      inFlight?.abort()
      inFlight = new AbortController()

      // El esqueleto espera 140 ms: un API rápido no debe hacerlo parpadear.
      const visibles = list.querySelectorAll('li').length
      mostradoEn = 0
      const lento = setTimeout(() => skeleton(visibles || EN_PORTADA), 140)
      estado.textContent = 'consultando…'

      const url = new URL('/v1/agencies', API)
      url.search = buildUrl().toString()

      try {
        const r = await fetch(url, { signal: inFlight.signal, headers: { Accept: 'application/json' } })
        if (!r.ok) throw new Error(`el API respondió ${r.status}`)
        const datos = await r.json()
        const agencies = datos.agencies ?? []
        clearTimeout(lento)

        // Si el esqueleto se mostró, al menos 260 ms en pantalla.
        const visto = mostradoEn ? performance.now() - mostradoEn : Infinity
        if (visto < 260) await new Promise((res) => setTimeout(res, 260 - visto))

        paint(agencies)
        list.removeAttribute('aria-busy')
        count(agencies.length, datos.pagination?.total ?? agencies.length)
        error.hidden = true
      } catch (e) {
        clearTimeout(lento)
        if (e.name === 'AbortError') return
        // Sin resultados viejos debajo del error: se leerían como la respuesta.
        list.innerHTML = ''
        list.removeAttribute('aria-busy')
        empty.hidden = true
        estado.textContent = ''
        error.textContent = `No se pudo consultar el catálogo: ${e.message}.`
        error.hidden = false
      }
    }

    const search = API ? query : filterLocal

    let timer = 0
    const schedule = () => {
      clearTimeout(timer)
      timer = setTimeout(search, 220)
    }

    q.addEventListener('input', () => {
      buildUrl()
      schedule()
    })
    carrier.addEventListener('change', search)

    if (API) search()
  })()
</script>

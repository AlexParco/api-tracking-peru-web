---
/* El interruptor de tema.
 *
 * Puede haber más de uno en la misma página (la barra y su menú móvil), así que
 * el script se engancha a todos los `[data-theme-toggle]` y los mantiene
 * sincronizados. Los dos iconos están en el HTML y el CSS decide cuál se ve según
 * `data-theme`: el icono correcto está desde el primer pintado.
 *
 * Dice adónde va, no dónde está: luna en claro (apretar = ir a oscuro).
 */
interface Props {
  id?: string
}

const { id = 'tema' } = Astro.props
---

<button
  type="button"
  id={id}
  data-theme-toggle
  class="btn -m-2 p-2 text-zinc-500 hover:bg-[var(--hover-soft)] hover:text-zinc-50"
  aria-label="Cambiar a tema oscuro"
>
  <svg class="tema-luna size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
  </svg>
  <svg class="tema-sol size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<style>
  :global(:root:not([data-theme='dark'])) .tema-sol,
  :global(:root[data-theme='dark']) .tema-luna {
    display: none;
  }
</style>

<script is:inline>
  ;(() => {
    // Idempotente: el componente puede emitir este script más de una vez.
    if (window.__temaListo) return
    window.__temaListo = true

    const raiz = document.documentElement
    const botones = () => document.querySelectorAll('[data-theme-toggle]')

    const rotular = () => {
      const oscuro = raiz.dataset.theme === 'dark'
      botones().forEach((b) =>
        b.setAttribute('aria-label', oscuro ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro'),
      )
    }

    document.addEventListener('click', (e) => {
      if (!e.target.closest('[data-theme-toggle]')) return
      const oscuro = raiz.dataset.theme === 'dark'
      if (oscuro) delete raiz.dataset.theme
      else raiz.dataset.theme = 'dark'
      rotular()
      try {
        localStorage.setItem('tema', oscuro ? 'light' : 'dark')
      } catch {}
      // Turnstile se renderiza con el tema del momento y no se entera del cambio.
      document.querySelectorAll('.cf-turnstile').forEach((w) => {
        w.setAttribute('data-theme', oscuro ? 'light' : 'dark')
      })
    })

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', rotular)
    else rotular()
  })()
</script>

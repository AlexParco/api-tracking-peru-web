---
import CodeBlock from './CodeBlock.astro'
import {
  CARRIERS,
  EVENTOS,
  WEBHOOKS_DECISIONES,
  EJEMPLO_WEBHOOK,
  FIRMA_WEBHOOK,
} from '../data/api.ts'

// La advertencia se DERIVA de la tabla de cobertura en vez de escribirse a mano.
// Si mañana se completa el rastreo de otro courier, este párrafo se corrige solo
// al actualizar CARRIERS — que es la única fuente que hay que tocar.
const suscribibles = CARRIERS.filter((c) => c.rastreo.estado === 'ok')
const nombres = suscribibles.map((c) => c.nombre)
const soloUno = suscribibles.length === 1
---

<section id="webhooks" class="scroll-mt-14 border-t border-line py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2
      class="max-w-2xl text-balance font-display text-3xl font-semibold tracking-tight text-zinc-50 md:text-4xl"
      data-revelar
    >
      Y si preferís no preguntar, te avisamos
    </h2>
    <p class="mt-4 max-w-2xl text-pretty leading-relaxed text-zinc-400" data-revelar style="--paso: 1">
      Registrás un endpoint HTTPS, suscribís un envío, y recibís un POST firmado cada vez
      que ese envío <strong class="font-medium text-zinc-300">cambia de estado</strong>. Un
      poller de fondo hace el trabajo aburrido con una cadencia que se acelera cerca de la
      entrega y se apaga sola cuando el envío termina.
    </p>

    <div class="mt-8 grid gap-3 sm:grid-cols-3">
      {
        [
          ['1', 'POST /v1/webhooks', 'Guardá el signing secret: se muestra una sola vez.'],
          ['2', 'POST /v1/tracking/subscriptions', 'Un envío por request.'],
          ['3', 'Tu endpoint recibe', 'Verificá la firma y respondé 2xx.'],
        ].map(([n, ruta, nota]) => (
          <div class="rounded-xl border border-line bg-ink-soft p-4">
            <span class="font-mono text-xs text-zinc-600">{n}</span>
            <code class="mt-1 block font-mono text-sm text-zinc-200">{ruta}</code>
            <p class="mt-1.5 text-sm leading-relaxed text-zinc-500">{nota}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:items-start">
      <div>
        <h3 class="text-sm font-medium text-zinc-300" data-revelar>Lo que conviene saber antes de escribir el receptor</h3>
        <dl class="mt-4 divide-y divide-line/60 border-y border-line/60">
          {
            WEBHOOKS_DECISIONES.map((d, i) => (
              <div class="py-3.5" data-revelar style={`--paso: ${i}`}>
                <dt class="text-sm font-medium text-zinc-200">{d.titulo}</dt>
                <dd class="mt-1 text-sm leading-relaxed text-zinc-500">{d.detalle}</dd>
              </div>
            ))
          }
        </dl>

        <h3 class="mt-8 text-sm font-medium text-zinc-300">Tipos de evento</h3>
        <dl class="mt-3 space-y-2.5">
          {
            EVENTOS.map((e, i) => (
              <div data-revelar style={`--paso: ${i}`}>
                <dt>
                  <code class="font-mono text-sm text-[var(--color-live)]">{e.nombre}</code>
                </dt>
                <dd class="mt-0.5 text-sm leading-relaxed text-zinc-500">{e.cuando}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="space-y-4" data-revelar style="--paso: 2">
        <CodeBlock titulo="una entrega, recortada" codigo={EJEMPLO_WEBHOOK} tono="brand" />
        <CodeBlock titulo="verificar la firma" codigo={FIRMA_WEBHOOK} />
        <p class="text-xs leading-relaxed text-zinc-600">
          El timestamp va <strong class="font-medium text-zinc-500">dentro</strong> de la
          firma, no al lado: es lo que te deja rechazar un replay. Firmá sobre el cuerpo
          crudo —re-serializarlo rompe el HMAC— y compará en tiempo constante.
        </p>
      </div>
    </div>

    {/* La misma regla que la tabla de cobertura: si el producto no lo hace
        todavía, la landing lo dice acá y no en la letra chica. */}
    <p
      class="tarjeta mt-12 max-w-2xl text-pretty rounded-xl border border-line bg-ink-soft p-5 text-sm leading-relaxed text-zinc-400"
      data-revelar
    >
      <strong class="font-medium text-[var(--color-partial)]">Alcance real, hoy:</strong>
      {' '}
      los webhooks están completos y probados de punta a punta, pero sólo se puede
      suscribir un envío de {nombres.join(', ')}, que {soloUno ? 'es el único courier' : 'son los couriers'}
      {' '}con rastreo operativo. Suscribir cualquier otro devuelve un error explícito en el
      POST, con el motivo — no te dejamos crear una suscripción que nunca iba a entregar
      nada.
    </p>
  </div>
</section>

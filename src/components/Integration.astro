---
import SectionHead from './SectionHead.astro'
import CodeBlock from './CodeBlock.astro'
import { ENDPOINTS, EVENTS, WEBHOOK_DECISIONS, WEBHOOK_EXAMPLE } from '../data/api.ts'

/* Consultar y que te avisen, en una banda de terminal.
 *
 * Es la única sección oscura en el tema claro (`.on-dark`): el código es su
 * contenido y los bloques de código son oscuros siempre, así que la banda
 * entera se vuelve terminal en vez de poner cajas negras sobre papel.
 *
 * Cuatro endpoints —uno por cosa que el API sabe hacer— y el webhook como una
 * pestaña más. `→` sale de tu código, `←` llega a tu código: pull y push, mismo
 * objeto, sin un párrafo que lo explique. La referencia completa vive en /docs.
 */
const methodClass: Record<string, string> = {
  GET: 'text-[var(--color-live)]',
  POST: 'text-[var(--color-method-write)]',
  DELETE: 'text-[var(--color-method-delete)]',
}

const eventNames = EVENTS.map((e) => e.name)
const EN_PORTADA = ['carriers', 'tracking', 'agencies', 'subscriptions']

const salientes = ENDPOINTS.filter((e) => EN_PORTADA.includes(e.id)).map((e) => ({
  id: e.id,
  direccion: 'out' as const,
  method: e.method,
  path: e.path,
  summary: e.summary,
  request: e.request,
  response: e.response,
  note: e.note,
}))

/* El webhook entra como fila sintética: nadie lo llama, lo llama el servicio. */
const entrante = {
  id: 'webhook-entrante',
  direccion: 'in' as const,
  method: 'POST' as const,
  path: 'tu endpoint',
  summary: 'Te avisamos cuando el envío cambia de estado. Llega el mismo objeto.',
  request: undefined,
  response: { title: 'POST a tu endpoint', code: WEBHOOK_EXAMPLE, lang: 'http' as const },
  note: 'Firmado con HMAC, con reintentos y deduplicación. El poller acelera cerca de la entrega y se apaga solo cuando el envío termina.',
}

const filas = [...salientes, entrante]
---

<section id="api" class="on-dark scroll-mt-14 border-t border-line pt-20 md:pt-28">
  <SectionHead n="02" kicker="Integración" title="Pregúntale, o deja que te avise">
    Siempre el mismo <code class="font-mono text-sm text-zinc-200">Shipment</code>: estado canónico,
    timeline ordenado con zona horaria explícita, bultos y pago. El literal del courier siempre
    adjunto en <code class="font-mono text-sm text-zinc-200">status_raw</code>, porque normalizar no
    debería significar perder el dato original.
  </SectionHead>

  {/* Pestañas horizontales, a sangre. En teléfono la fila scrollea de costado:
      cinco rutas en mono no entran en 390 px y partirlas en dos líneas cada una
      las vuelve ilegibles. ARIA de tablist: flechas, Inicio y Fin. */}
  <div
    role="tablist"
    aria-label="Llamadas del API y webhook entrante"
    class="scroll-shadow mt-16 flex overflow-x-auto border-y border-line"
    style="--scroll-bg: var(--color-ink)"
    data-reveal
  >
    {
      filas.map((e, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${e.id}`}
          aria-controls={`panel-${e.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab
          class="group relative flex shrink-0 cursor-pointer items-baseline gap-2.5 border-r border-line px-5 py-4 text-left transition-colors hover:bg-[var(--hover-soft)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand/60 aria-selected:bg-ink-soft lg:flex-1 lg:px-6"
        >
          <span
            aria-hidden="true"
            class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-[#a3e635] transition-transform duration-300 group-aria-selected:scale-x-100"
          />
          <span class="font-mono text-xs text-zinc-600" aria-hidden="true">
            {e.direccion === 'out' ? '→' : '←'}
          </span>
          <span class:list={['font-mono text-xs font-semibold', methodClass[e.method]]}>{e.method}</span>
          <code class="whitespace-nowrap font-mono text-sm text-zinc-400 transition-colors group-hover:text-zinc-100 group-aria-selected:text-zinc-50">
            {e.path}
          </code>
          {e.direccion === 'in' && <span class="eyebrow text-zinc-600">webhook</span>}
        </button>
      ))
    }
  </div>

  <div data-reveal style="--step: 1">
    {
      filas.map((e, i) => (
        <div
          role="tabpanel"
          id={`panel-${e.id}`}
          aria-labelledby={`tab-${e.id}`}
          tabindex="0"
          hidden={i !== 0}
          data-panel
          class="grid focus-visible:outline-none lg:grid-cols-12"
        >
          <div class="border-b border-line px-5 py-8 sm:px-8 lg:col-span-4 lg:border-b-0 lg:border-r lg:px-12 lg:py-12">
            <p class="eyebrow text-zinc-600">{e.direccion === 'out' ? 'Llamas tú' : 'Te llamamos'}</p>
            <p class="mt-4 text-pretty font-display text-2xl font-semibold leading-snug tracking-tight text-zinc-50">
              {e.summary}
            </p>
            {e.note && <p class="mt-5 text-pretty text-sm leading-relaxed text-zinc-500">{e.note}</p>}
          </div>

          {/* Alto fijo en escritorio: cambiar de pestaña no hace saltar la
              página. La respuesta larga scrollea dentro de su caja. */}
          <div class="min-w-0 space-y-4 px-5 py-8 sm:px-8 lg:col-span-8 lg:h-[34rem] lg:overflow-y-auto lg:px-12 lg:py-12">
            {e.request && <CodeBlock title={e.request.title} code={e.request.code} />}
            <CodeBlock
              title={e.response.title}
              code={e.response.code}
              lang={'lang' in e.response ? e.response.lang : 'json'}
              tone="brand"
            />
          </div>
        </div>
      ))
    }
  </div>

  <div
    class="flex flex-col gap-4 border-t border-line px-5 py-6 text-sm sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:px-12"
    data-reveal
  >
    <p class="flex flex-wrap items-center gap-2">
      <span class="eyebrow mr-2 text-zinc-600">Cuatro eventos</span>
      {eventNames.map((n) => <code class="border border-line px-2 py-1 font-mono text-xs text-[var(--color-live)]">{n}</code>)}
    </p>
    <p class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <a href="/docs#webhooks-reglas" class="text-zinc-400 underline-offset-4 hover:text-zinc-50 hover:underline">
        Las {WEBHOOK_DECISIONS.length} reglas del receptor
      </a>
      <a href="/docs#ep-carriers" class="font-medium text-brand underline-offset-4 hover:underline">
        Ver los {ENDPOINTS.length} endpoints en la referencia →
      </a>
    </p>
  </div>
</section>

<script is:inline>
  ;(() => {
    const list = document.querySelector('[role="tablist"][aria-label="Llamadas del API y webhook entrante"]')
    if (!list) return
    const tabs = [...list.querySelectorAll('[data-tab]')]
    const panels = [...document.querySelectorAll('[data-panel]')]
    if (!tabs.length || tabs.length !== panels.length) return

    const select = (i, moveFocus) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(j === i))
        t.tabIndex = j === i ? 0 : -1
      })
      panels.forEach((p, j) => p.toggleAttribute('hidden', j !== i))
      if (moveFocus) tabs[i].focus()
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' })
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false))
      tab.addEventListener('keydown', (ev) => {
        const jump = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[ev.key]
        let target = null
        if (jump) target = (i + jump + tabs.length) % tabs.length
        else if (ev.key === 'Home') target = 0
        else if (ev.key === 'End') target = tabs.length - 1
        if (target === null) return
        ev.preventDefault()
        select(target, true)
      })
    })
  })()
</script>

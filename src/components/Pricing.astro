---
import SectionHead from './SectionHead.astro'
import { PLANS, INCLUDED_IN_ALL, ORDERS, miles, cuantos, annualSaving, planLink, type Plan } from '../data/plans.ts'
import { PUBLISHED_CARRIERS, METRICS } from '../data/api.ts'

const tracking = PUBLISHED_CARRIERS.filter((c) => c.tracking.status === 'ok').length
const withCatalog = PUBLISHED_CARRIERS.filter((c) => c.agencies.status === 'ok').length


/* La tabla publica TODOS los planes, que son exactamente los que el backend sabe
   emitir. La banda de «Enterprise desde S/ 349» se quitó el 2026-09-15: estaba
   anclada al Pro viejo de S/ 99 y no existe ningún plan detrás de ese piso.
   Quien necesita más que Premium escribe por el mismo correo que todos. */
const planes = PLANS

/* Las filas comparables, en el mismo orden para todos los planes. Órdenes va
   primero cuando está encendido: es lo que se compara antes que nada. */
const filas: { label: string; value: (p: Plan) => string | number | null; fallback: string }[] = [
  ...(ORDERS.enabled
    ? [
        {
          label: 'Órdenes al mes',
          value: (p: Plan) => p.ordersLabel ?? (p.orders === null ? null : miles(p.orders)),
          fallback: 'negociado',
        },
      ]
    : []),
  { label: 'Webhooks activos', value: (p) => p.webhooksLabel ?? p.webhooks, fallback: 'negociado' },
  { label: 'Requests por minuto', value: (p) => p.rpm, fallback: 'negociado' },
  { label: 'Consultas de rastreo', value: (p) => p.queries, fallback: '' },
  { label: 'Soporte', value: (p) => p.support, fallback: '' },
]

/* Cabecera + resumen + filas + botón. Con subgrid, las filas de todos los planes
   comparten altura: la tabla se lee en horizontal sin ser una `<table>`, que en
   un teléfono habría que scrollear de costado. */
const rowCount = filas.length + 3
---

<section id="pricing" class="scroll-mt-14 border-t border-line pt-20 md:pt-28">
  <SectionHead n="06" kicker="Precios" title="Una key, un plan, sin sorpresas">
    Los {cuantos(PLANS.length)} llegan a los mismos endpoints y a los mismos carriers. Lo que
    cambia es{' '}
    {ORDERS.enabled ? 'cuántas órdenes creas al mes' : 'cuántos envíos puedes tener vigilados a la vez'}{' '}
    —ese es el medidor— y cómo te respondemos cuando algo se rompe.
  </SectionHead>

  <div
    class="mt-16 grid border-t border-line lg:grid-cols-[13rem_repeat(var(--cols),minmax(0,1fr))]"
    style={`--cols: ${planes.length}; --rows: ${rowCount}`}
  >
    {/* La columna de rótulos existe sólo en escritorio y es decorativa: cada
        casillero lleva su propio rótulo, visible en teléfono y `sr-only` acá. */}
    <div class="hidden lg:row-span-[var(--rows)] lg:grid lg:grid-rows-subgrid" aria-hidden="true">
      <div class="px-12 py-8"></div>
      <div class="eyebrow border-t border-line px-12 py-5 text-zinc-600">Para quién</div>
      {filas.map((f) => <div class="eyebrow flex items-center border-t border-line px-12 py-4 text-zinc-600">{f.label}</div>)}
      <div class="border-t border-line"></div>
    </div>

    {
      planes.map((p, i) => {
        const saving = annualSaving(p)
        return (
          <div
            role="group"
            aria-labelledby={`plan-${p.id}`}
            class:list={[
              'grid lg:row-span-[var(--rows)] lg:grid-rows-subgrid lg:border-l lg:border-line',
              i > 0 && 'border-t border-line lg:border-t-0',
            ]}
            data-reveal
            style={`--step: ${i}`}
          >
            <div class="px-5 py-8 sm:px-8 lg:px-8">
              <div class="flex items-center justify-between gap-3">
                <h3 id={`plan-${p.id}`} class="eyebrow font-semibold text-zinc-50">{p.name}</h3>
                <span class="eyebrow text-zinc-700" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <p class="mt-6 flex items-baseline gap-1.5">
                <span class="font-mono text-sm text-zinc-500">S/</span>
                <span class="font-display text-6xl font-semibold tabular-nums tracking-[-0.04em] text-zinc-50">
                  {p.free ? '0' : p.monthly}
                </span>
                <span class="text-sm text-zinc-500">{p.free ? 'para siempre' : 'al mes'}</span>
              </p>
              <p class="mt-2 min-h-5 text-sm text-zinc-500">
                {p.free && 'sin tarjeta, no vence'}
                {!p.free && p.annual !== null && saving && (
                  <>
                    o <span class="tabular-nums text-zinc-300">S/ {miles(p.annual)}</span> al año —{' '}
                    <span class="chip-lime px-1 font-medium">{saving.months} meses gratis</span>
                  </>
                )}
              </p>
            </div>

            <div class="border-t border-line px-5 py-5 sm:px-8">
              <p class="eyebrow text-zinc-600 lg:sr-only">Para quién</p>
              <p class="mt-1 text-pretty text-sm leading-relaxed text-zinc-400 lg:mt-0">{p.summary}</p>
            </div>

            {filas.map((f) => {
              const v = f.value(p)
              return (
                <div class="flex items-center justify-between gap-4 border-t border-line px-5 py-4 sm:px-8 lg:block">
                  <p class="eyebrow text-zinc-600 lg:sr-only">{f.label}</p>
                  <p
                    class:list={[
                      'text-right font-mono tabular-nums lg:text-left',
                      v === null ? 'text-xs text-zinc-500' : 'text-sm text-zinc-100',
                    ]}
                  >
                    {v === null ? f.fallback : v}
                  </p>
                </div>
              )
            })}

            <div class="border-t border-line p-5 sm:px-8">
              <a
                href={planLink(p)}
                class:list={['btn block px-5 py-3 text-center font-medium', p.free ? 'btn-primary' : 'btn-secondary']}
              >
                {p.free ? 'Empezar gratis' : 'Contratar por correo'}
              </a>
            </div>
          </div>
        )
      })
    }
  </div>

  <div class="grid border-t border-line lg:grid-cols-12" data-reveal>
    <div class="px-5 py-10 sm:px-8 lg:col-span-8 lg:border-r lg:border-line lg:px-12">
      <h3 class="eyebrow text-zinc-500">Todos los planes incluyen</h3>
      <ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {
          INCLUDED_IN_ALL.map((x) => (
            <li class="flex gap-3 text-sm leading-relaxed text-zinc-300">
              <span class="chip-lime mt-0.5 grid size-4 shrink-0 place-items-center font-mono text-[10px] font-bold" aria-hidden="true">
                ✓
              </span>
              <span class="text-pretty">{x}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 max-w-2xl text-pretty text-xs leading-relaxed text-zinc-600">
        Hoy eso son {tracking} couriers con rastreo operativo y {withCatalog} catálogos de
        agencias ({METRICS.agenciesSynced} puntos sincronizados). Los que faltan entran a tu key
        sin que pagues de nuevo.
      </p>
    </div>

    {/* Qué pasa al hacer clic. Quien ve un precio asume que hay un checkout;
        descubrir el correo después del clic es peor que leerlo antes. */}
    <div class="border-t border-line px-5 py-10 sm:px-8 lg:col-span-4 lg:border-t-0 lg:px-10">
      <p class="eyebrow text-zinc-500">Cómo se paga</p>
      <p class="mt-5 text-pretty text-sm leading-relaxed text-zinc-400">
        Los planes pagos se coordinan por correo: el botón abre uno con el plan en el
        asunto, y te emitimos la key el mismo día. Sin formulario y sin tarjeta guardada.
      </p>
    </div>
  </div>
</section>

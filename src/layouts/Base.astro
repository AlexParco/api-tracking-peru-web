---
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Datos estructurados de la página. Se serializan en el `<head>`. */
  jsonLd?: Record<string, unknown>
  /**
   * La página vive dentro del marco de la guía (reglas a los costados y fondo
   * exterior un peldaño más gris). /docs no lo usa: tiene su propio armazón de
   * barra lateral fija.
   */
  framed?: boolean
  /** Fuera del índice de buscadores. Lo usan las maquetas de cuenta. */
  noindex?: boolean
}

const { title, description, jsonLd, framed = true, noindex = false } = Astro.props

/* Páginas donde no se carga ninguna métrica: las que muestran credenciales o
   datos de la cuenta. Mismo criterio que el `inAccount` de la barra. */
const SIN_METRICAS = ['/login', '/dashboard'].some((r) => Astro.url.pathname.startsWith(r))

const SITIO = 'API Tracking Perú'
const ORIGEN = Astro.site ?? new URL('https://tracking-peru.com')
const canonical = new URL(Astro.url.pathname, ORIGEN)

/* La vista previa. Absoluta y no relativa: los rastreadores de WhatsApp, Slack
   y X no resuelven rutas contra la página, la descartan. */
const og = new URL('/og.png', ORIGEN)
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Los dos temas, con el claro primero: el orden importa porque el primero
        es el que el navegador usa para pintar el fondo y las barras de scroll
        antes de que la hoja cargue. El CSS y el script del final del <head>
        deciden cuál queda.

        `theme-color` con `media` da el color de la barra del navegador en móvil
        para cada caso; sin el `media`, Android pintaba la barra de negro también
        en el tema claro. */}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#08090b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITIO} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:image" content={og} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="API Tracking Perú — rastreo y agencias de couriers peruanos detrás de un solo contrato"
    />

    {/* `summary_large_image` con imagen. Declararlo sin ella —como estaba— hace
        que X degrade a una tarjeta vacía, que es peor que no declarar nada. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    {/* El favicon apunta a ARCHIVOS con URL propia, no a un data: URI: Google
         sólo muestra el ícono del resultado de búsqueda si puede RASTREAR su URL,
         y un data URI no es rastreable (por eso no salía en los resultados). El
         SVG es la fuente moderna —Google y los navegadores actuales lo prefieren—
         y el .ico el fallback clásico (además de la ruta /favicon.ico que Google
         busca por defecto). El favicon.svg es idéntico al data URI que había acá.

         OJO CON EL `sizes` DEL .ico. Estaba en `any`, y eso hacía que Chrome
         eligiera el .ico en vez del SVG: «any» se interpreta como escalable, o
         sea tan buen candidato como el vectorial, y ante el empate gana el
         último declarado. Con una medida concreta el SVG queda como la única
         opción escalable y se lleva la pestaña.

         Eso, sumado a que el .ico era el logotipo de Astro que venía del
         andamiaje —un PNG de 32×32 con la extensión cambiada, nunca
         reemplazado—, es por lo que en la pestaña se veía Astro. El .ico ahora
         lo genera `scripts/favicon.py` desde el mismo isotipo, con 16, 32 y 48
         adentro. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Safari en la barra de marcadores usa el mask-icon, no el SVG. */}
    <link rel="mask-icon" href="/favicon.svg" color="#a3e635" />
    {/* iOS al guardar en pantalla de inicio: PNG opaco, sin transparencia. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

    {/* Microsoft Clarity — mapas de calor y repetición de sesión.
        Sólo en producción: `import.meta.env.PROD` es false en `astro dev`, así
        que las sesiones de desarrollo no ensucian las métricas con recargas y
        pruebas. Astro lo evalúa al compilar, o sea que en el build de desarrollo
        el `<script>` ni siquiera existe.

        `is:inline` para que Astro no lo procese ni lo empaquete: el sitio no
        envía bundles, y éste tiene que quedar tal cual lo publica Clarity.

        ── Y NUNCA en las páginas de cuenta ──

        Clarity no mide clics: reconstruye la sesión, o sea que lo que se ve en
        pantalla queda grabado del lado de Microsoft. En `/dashboard` eso incluye
        la API key del cliente, que es una credencial: basta con leerla de una
        repetición para usar su cuota y su cuenta. En `/login` incluye el correo
        con el que se pide el enlace de acceso.

        Ninguna de esas páginas necesita métricas —no son páginas de captación—,
        así que el script directamente no se sirve ahí. Se decide por RUTA y no
        por una prop del layout a propósito: una página nueva bajo /dashboard
        queda excluida sola, sin que nadie tenga que acordarse.

        Lo que esto NO cubre: la portada muestra la key recién creada al terminar
        el alta gratuita, y ahí Clarity sí corre porque es la página que hay que
        medir. Ese caso se resuelve enmascarando ese bloque en `TrialForm.astro`.

        Es el ÚNICO tercero del sitio. Si algún día se agrega un CSP al nginx,
        necesita `script-src https://www.clarity.ms` y `connect-src` hacia
        `https://*.clarity.ms`, o deja de reportar en silencio. */}
    {
      import.meta.env.PROD && !SIN_METRICAS && (
        <script
          is:inline
          set:html={`(function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xyelirog6s");`}
        />
      )
    }

    {/* Se decide ANTES de pintar, y por eso va en el <head> y no al final: si
        el estado inicial de las animaciones se aplicara después del primer
        pintado, el contenido se vería y recién ahí se escondería para entrar.
        Si el visitante pidió menos movimiento, la clase no se agrega y ninguna
        regla de animación llega a existir. */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion')
      }

      /* El tema, también antes de pintar y por el mismo motivo: leerlo después
         del primer pintado significa que quien eligió oscuro ve un fogonazo
         blanco en cada navegación. Es la única razón por la que este script
         vive en el <head> y bloquea.

         El DEFECTO es claro. No se mira `prefers-color-scheme`: es una decisión
         de producto —el sitio se presenta en claro— y no una preferencia que
         adivinar. Lo que sí se respeta es la elección explícita del visitante,
         que persiste en localStorage.

         `try` porque en una ventana privada o con las cookies bloqueadas
         `localStorage` no lee: ahí cae al defecto en vez de reventar el script
         que además pone `.motion`. */
      try {
        if (localStorage.getItem('tema') === 'dark') {
          document.documentElement.dataset.theme = 'dark'
        }
      } catch {}
    </script>
  </head>

  <body class:list={['text-zinc-200 antialiased', framed ? 'bg-ink-soft' : 'bg-ink']}>
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:font-medium focus:text-ink"
    >
      Saltar al contenido
    </a>
    <slot />

    <script is:inline>
      ;(() => {
        // La barra no es movimiento: separa la nav del contenido cuando hay
        // contenido debajo. Corre siempre, incluso con reduced-motion.
        const header = document.querySelector('header')
        if (header) {
          const mark = () => header.toggleAttribute('data-scrolled', scrollY > 8)
          mark()
          addEventListener('scroll', mark, { passive: true })
        }

        if (!document.documentElement.classList.contains('motion')) return

        // Los contadores arrancan desde cero SÓLO aquí: el valor real ya está en
        // el HTML, así que sin JS —o con reduced-motion— se lee el número
        // correcto y no un cero animándose que nunca llega.
        const count = (el) => {
          const target = Number(el.dataset.counter)
          if (!Number.isFinite(target)) return
          const arranque = performance.now()
          const tick = (t) => {
            // `t` de rAF puede ser ANTERIOR a `arranque` (se tomó con performance.now()
            // un instante después): sin el piso en 0 el primer cuadro mostraba negativos.
            const progress = Math.min(1, Math.max(0, (t - arranque) / 950))
            const eased = 1 - (1 - progress) ** 3
            // El valor exacto se escribe al final y no se drift del easing:
            // redondear 817,6 daría 818 por casualidad, no por corrección.
            el.textContent = progress < 1 ? String(Math.round(target * eased)) : String(target)
            if (progress < 1) requestAnimationFrame(tick)
          }
          requestAnimationFrame(tick)
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue
              e.target.classList.add('visible')
              if (e.target.dataset.counter) count(e.target)
              // Una sola vez: que las cosas se desvanezcan al volver a
              // scrollear marea y no aporta nada.
              observer.unobserve(e.target)
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.01 },
        )

        for (const el of document.querySelectorAll('[data-reveal], [data-counter]')) {
          observer.observe(el)
        }
      })()
    </script>
  </body>
</html>

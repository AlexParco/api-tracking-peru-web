---
import '../styles/global.css'
import Reticle from '../components/Reticle.astro'

interface Props {
  title: string
  description: string
  /** Datos estructurados de la página. Se serializan en el `<head>`. */
  jsonLd?: Record<string, unknown>
}

const { title, description, jsonLd } = Astro.props

const SITIO = 'API Tracking Perú'
const ORIGEN = Astro.site ?? new URL('https://tracking-peru.com')
const canonical = new URL(Astro.url.pathname, ORIGEN)

/* La vista previa. Absoluta y no relativa: los rastreadores de WhatsApp, Slack
   y X no resuelven rutas contra la página, la descartan. */
const og = new URL('/og.png', ORIGEN)
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* El sitio es de tema oscuro fijo. Declararlo acá y no sólo en el CSS evita
        el destello blanco antes de que la hoja cargue: el navegador ya pinta el
        fondo y las barras de scroll en oscuro. */}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08090b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITIO} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:image" content={og} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="API Tracking Perú — rastreo y agencias de couriers peruanos detrás de un solo contrato"
    />

    {/* `summary_large_image` con imagen. Declararlo sin ella —como estaba— hace
        que X degrade a una tarjeta vacía, que es peor que no declarar nada. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <!-- El isotipo, inline como data URI: un archivo menos que pedir. Trazo 2.6
         en vez de 2 y el cuadrado lima de fondo: a 16 px el trazo normal funde
         las tres entradas y el símbolo suelto se pierde contra la pestaña. Es la
         versión para tamaños chicos, no el mismo SVG escalado. -->
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><rect width='24' height='24' rx='5' fill='%23a3e635'/><path d='M3 5c5 0 5 7 9 7M3 12h9M3 19c5 0 5-7 9-7M12 12h9' fill='none' stroke='%2308090b' stroke-width='2.6' stroke-linecap='round'/></svg>"
    />
    <!-- Safari en la barra de marcadores usa el mask-icon, no el SVG. -->
    <link rel="mask-icon" href="/favicon.svg" color="#a3e635" />
    <!-- iOS al guardar en pantalla de inicio: PNG opaco, sin transparencia. -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

    {/* Microsoft Clarity — mapas de calor y repetición de sesión.
        Sólo en producción: `import.meta.env.PROD` es false en `astro dev`, así
        que las sesiones de desarrollo no ensucian las métricas con recargas y
        pruebas. Astro lo evalúa al compilar, o sea que en el build de desarrollo
        el `<script>` ni siquiera existe.

        `is:inline` para que Astro no lo procese ni lo empaquete: el sitio no
        envía bundles, y éste tiene que quedar tal cual lo publica Clarity.

        Es el ÚNICO tercero del sitio. Si algún día se agrega un CSP al nginx,
        necesita `script-src https://www.clarity.ms` y `connect-src` hacia
        `https://*.clarity.ms`, o deja de reportar en silencio. */}
    {
      import.meta.env.PROD && (
        <script
          is:inline
          set:html={`(function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xyelirog6s");`}
        />
      )
    }

    {/* Se decide ANTES de pintar, y por eso va en el <head> y no al final: si
        el estado inicial de las animaciones se aplicara después del primer
        pintado, el contenido se vería y recién ahí se escondería para entrar.
        Si el visitante pidió menos movimiento, la clase no se agrega y ninguna
        regla de animación llega a existir. */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion')
      }
    </script>
  </head>

  <body class="bg-ink text-zinc-200 antialiased">
    {/* La retícula, una sola vez y para todo el documento. Va aquí y no en cada
        página porque es fondo, no contenido: dos instancias serían dos grillas
        desalineadas y dos scripts peleando por el mismo cursor. */}
    <Reticle />

    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:font-medium focus:text-ink"
    >
      Saltar al contenido
    </a>
    <slot />

    <script is:inline>
      ;(() => {
        // La barra no es movimiento: separa la nav del contenido cuando hay
        // contenido debajo. Corre siempre, incluso con reduced-motion.
        const header = document.querySelector('header')
        if (header) {
          const mark = () => header.toggleAttribute('data-scrolled', scrollY > 8)
          mark()
          addEventListener('scroll', mark, { passive: true })
        }

        if (!document.documentElement.classList.contains('motion')) return

        // Los contadores arrancan desde cero SÓLO aquí: el valor real ya está en
        // el HTML, así que sin JS —o con reduced-motion— se lee el número
        // correcto y no un cero animándose que nunca llega.
        const count = (el) => {
          const target = Number(el.dataset.counter)
          if (!Number.isFinite(target)) return
          const arranque = performance.now()
          const tick = (t) => {
            const progress = Math.min(1, (t - arranque) / 950)
            const eased = 1 - (1 - progress) ** 3
            // El valor exacto se escribe al final y no se drift del easing:
            // redondear 817,6 daría 818 por casualidad, no por corrección.
            el.textContent = progress < 1 ? String(Math.round(target * eased)) : String(target)
            if (progress < 1) requestAnimationFrame(tick)
          }
          requestAnimationFrame(tick)
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue
              e.target.classList.add('visible')
              if (e.target.dataset.counter) count(e.target)
              // Una sola vez: que las cosas se desvanezcan al volver a
              // scrollear marea y no aporta nada.
              observer.unobserve(e.target)
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.01 },
        )

        for (const el of document.querySelectorAll('[data-reveal], [data-counter]')) {
          observer.observe(el)
        }
      })()
    </script>
  </body>
</html>
